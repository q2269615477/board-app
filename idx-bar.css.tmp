#toolbar{display:flex;align-items:stretch;background:#131722;border-bottom:1px solid #2a2e39;height:36px;overflow:hidden}
.tab-btn{padding:0 10px;border:none;background:transparent;color:#787b86;font-size:11px;cursor:pointer;white-space:nowrap}
.tab-btn:hover{color:#d1d4dc}
.tab-btn.active{color:#2962ff;border-bottom:2px solid #2962ff}
#index-bar{display:flex;align-items:stretch;gap:0;overflow-x:auto;overflow-y:hidden;flex:1;scrollbar-width:none;cursor:grab;user-select:none}
#index-bar::-webkit-scrollbar{display:none}
#index-bar:active{cursor:grabbing}
.idx-group{display:flex;align-items:stretch;border-right:1px solid #2a2e39;padding:0 2px}
.idx-group:last-child{border-right:none}
.idx-label{display:flex;align-items:center;padding:0 4px;color:#434651;font-size:9px;font-weight:600;white-space:nowrap;letter-spacing:0.5px}
.idx-item{display:flex;align-items:center;gap:3px;padding:0 6px;cursor:pointer;border-radius:2px;position:relative;transition:all 0.15s;white-space:nowrap;font-size:10px}
.idx-item:hover{background:#2a2e39}
.idx-item.active{background:#2962ff}
.idx-item .name{color:#d1d4dc;font-size:10px}
.idx-item .price{font-size:10px;font-weight:600;min-width:42px;text-align:right;font-variant-numeric:tabular-nums}
.idx-item .price.up{color:#ef5350}
.idx-item .price.down{color:#26a69a}
.idx-item .price.flat{color:#787b86}
.idx-del{position:absolute;top:-1px;right:-1px;width:11px;height:11px;border-radius:50%;background:#ef5350;color:#fff;font-size:8px;line-height:11px;text-align:center;cursor:pointer;display:none;z-index:10}
.idx-item:hover .idx-del{display:block}
