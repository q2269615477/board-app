        + '<span class="name">'+escHtml(it.name)+'</span>'
        + '<span class="price flat" id="prc_'+it.ticker+'">'+it.price+'</span>'
        + '<span class="idx-del" onclick="delIdxItem(event,this)" title="移除">✕</span>'
        + '</div>';
    });
    h += '</div>';
  });
  bar.innerHTML = h;
  const first = bar.querySelector('.idx-item');
  if(first) first.classList.add('active');
  // 拖动
  bar.querySelectorAll('.idx-item').forEach(it => {
    it.addEventListener('dragstart', e => { _idxBarDragEl = it; setTimeout(() => it.style.opacity='0.3',0); });
    it.addEventListener('dragend', () => { if(_idxBarDragEl) _idxBarDragEl.style.opacity='1'; _idxBarDragEl=null; });
    it.addEventListener('dragover', e => {
      e.preventDefault(); if(!_idxBarDragEl || _idxBarDragEl===it) return;
      const r = it.getBoundingClientRect(), mid = r.left + r.width/2, p = it.parentNode;
      p.insertBefore(_idxBarDragEl, e.clientX<mid ? it : it.nextSibling);
    });
  });
}
function clickIdxItem(el){
  document.querySelectorAll('.idx-item.active').forEach(e=>e.classList.remove('active'));
  el.classList.add('active');
  const sym = JSON.parse(el.dataset.sym);
  selectBoard(sym.name, sym.ticker, sym.type, null);
}
function ctxIdxItem(ev, el){
  ev.preventDefault();
  const sym = JSON.parse(el.dataset.sym);
  window._ctxIdx = sym;
  showCtxMenu(ev.clientX, ev.clientY,
    '<div class="ctx-item" style="color:#434651;cursor:default">'+escHtml(sym.name)+'</div>'
    + '<div class="ctx-sep"></div>'
    + '<div class="ctx-item" onclick="delIdxItem(null,document.querySelector(\'#prc_'+sym.ticker+'\').closest(\'.idx-item\').querySelector(\'.idx-del\'))">移除</div>'
    + '<div class="ctx-item" onclick="closeCtx()">取消</div>');
}
function delIdxItem(ev, delBtn){
  if(ev) ev.stopPropagation();
  const item = delBtn.closest('.idx-item');
  if(item) { item.remove(); toast('已移除'); }
  closeCtx();
}
async function refreshIdxPrices(){
  try{
    const r = await fetch(API+'/api/spot/indices');
    const j = await r.json();
    if(j.data){
      Object.entries(j.data).forEach(([code, v]) => {
        const el = document.getElementById('prc_'+code);
        if(!el) return;
        const price = (v.price||0).toFixed(code.match(/^HSI$|HSTECH|N225/) ? 0 : 2);
        el.textContent = price;
        el.className = 'price ' + ((v.change_pct||0)>0?'up':(v.change_pct||0)<0?'down':'flat');
      });
    }
  }catch(e){}
}
function addCurrentToIndexBar(){
  if(!store.selected) return;
  const s = store.selected;
  if(document.getElementById('prc_'+s.code)) { toast('已在导航栏中'); return; }
  const lastGroup = document.querySelector('.idx-group:last-child');
  const it = {ticker:s.code, type:s.type, name:s.name, price:'─'};
  const div = document.createElement('div');
  div.className = 'idx-item'; div.draggable = true;
  div.dataset.sym = JSON.stringify(it);
  div.innerHTML = '<span class="name">'+escHtml(s.name)+'</span><span class="price flat" id="prc_'+s.code+'">─</span><span class="idx-del" onclick="delIdxItem(event,this)">✕</span>';
  div.onclick = function(){clickIdxItem(this);};
  lastGroup.appendChild(div);
  toast('已添加到导航栏');
}
renderIndexBar();
setInterval(refreshIdxPrices, 30000);
setTimeout(refreshIdxPrices, 1000);

// ===== 6. 信号 =====
async function loadSignals(code){
  const list=document.getElementById('signal-list');
  try{
    const r=await fetch(API+'/api/signals/'+code);const s=await r.json();
    let h='';
    Object.entries(s).forEach(([sk,sigs])=>{
      if(!Array.isArray(sigs))return;
      sigs.slice(-5).forEach(sg=>{
        const c=(sg.type||'').toLowerCase().includes('sos')?'buy':'sell';
        h+='<div class="signal-row"><span class="signal-date">'+(sg.date||'').slice(5)+'</span><span class="signal-badge '+c+'">'+(sg.type||'?')+'</span>'+(sg.note||'')+'</div>';
      });
    });
    list.innerHTML=h||'<span style="color:#434651">暂无信号</span>';
  }catch(e){list.innerHTML='<span style="color:#ef5350">加载失败</span>';}
}

// ===== 7. AI 技能（双向集成：按钮→API调用→AI结论回写面板） =====
// 预置默认技能
const _defaultSkills = [
  {
    id: 'default_bar_analysis',
    name: '逐K量价分析',
    label: '逐K量价分析(威科夫)',
    prompt: '请对{name}({code})进行逐K量价分析。\n要求：\n1. 逐根分析最近20根日K线\n2. 标注WRB长柱和NR短柱\n3. 识别威科夫关键事件（SC/BC/SOS/JOC/SOW/Spring等）\n4. 判断当前市场阶段（吸筹/上涨/派发/下跌）\n5. 给出支撑/阻力价位\n6. 评估趋势健康度',
    workbuddy: '逐K分析器'
  },
  {
    id: 'default_top_warning',
    name: '顶部预警',
    label: '顶部预警',
    prompt: '请对{name}({code})进行顶部预警分析。\n要求：\n1. 检查是否存在派发迹象（BC/ST/UT/SOW等）\n2. 评估顶部形成的概率\n3. 如果正在派发，估算下跌目标\n4. 给出止损价位建议',
    workbuddy: '量价顶部预警'
  },
  {
    id: 'default_bottom_confirm',
    name: '底部确认',
    label: '底部确认',
    prompt: '请对{name}({code})进行底部确认分析。\n要求：\n1. 检查是否存在吸筹迹象（SC/ST/SOS/JOC/Spring等）\n2. 评估底部形成的概率\n3. 如果正在吸筹，估算上涨目标\n4. 给出入场价位建议',
    workbuddy: '量价底部确认'
  }
];

function ensureDefaultSkills(){
  // 读取已保存的技能
  let saved = [];
  try{
    const raw = localStorage.getItem('ai_skills');
    if(raw) saved = JSON.parse(raw) || [];
  }catch(e){ saved = []; }
  
  // 合并：保留用户自定义技能，补充缺失的预置技能
  const existingIds = new Set(saved.map(s => s.id));
  let modified = false;
  for(const ds of _defaultSkills){
    if(!existingIds.has(ds.id)){
      saved.push(ds);
      modified = true;
    }
  }
  // 如果没有保存任何技能，使用全部预置技能
  if(saved.length === 0){
    saved = [..._defaultSkills];
    modified = true;
  }
  store._skills = saved;
  if(modified){
    try{ localStorage.setItem('ai_skills', JSON.stringify(store._skills)); }catch(e){}
  }
}

function renderSkills(){
  const list=document.getElementById('skill-list');
  let h='<div style="padding:4px 10px;font-size:10px;color:#434651;border-bottom:1px solid #1e2230">点击技能→自动分析→结论回写面板</div>';
  store._skills.forEach(s=>{
    h+='<div class="skill-item"><span class="skill-label">'+escHtml(s.label)+'</span><button class="skill-btn" data-sid="'+escAttr(s.id||'')+'" data-prompt="'+escAttr(s.prompt)+'" data-wb="'+escAttr(s.workbuddy||'')+'"><span class="skill-btn-text">'+escHtml(s.name||s.label)+'</span><span class="skill-status"></span></button></div>';
  });
  if(!store._skills.length)h='<div style="padding:8px 10px;font-size:11px;color:#434651">暂无技能，点击＋从市场添加</div>';
  list.innerHTML=h;
  list.querySelectorAll('.skill-btn').forEach(b=>b.onclick=function(){
    if(!store.selected){toast('请先选择板块或个股');return;}
    triggerAiAnalysis(this, store.selected);
  });
}

// 触发AI分析：调用面板后端 → 后端推SSE → 前端监听并回写结论
async function triggerAiAnalysis(btn, board){
  const sid = btn.dataset.sid || ('sk_'+Date.now());
  const prompt = btn.dataset.prompt;
  const wbSkill = btn.dataset.wb;
  btn.classList.add('analyzing');
  btn.querySelector('.skill-status').textContent='⏳';
  try{
    const r = await fetch(API+'/mcp/call', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({tool:'trigger_ai_analysis', arguments:{
        board_code: board.code, board_name: board.name, board_type: board.type,
        skill_id: sid, skill_name: wbSkill || board.name,
        prompt_template: prompt, callback_id: ''
      }})
    });
    const j = await r.json();
    if(j.prompt){
      try{ await navigator.clipboard.writeText(j.prompt); toast('已复制分析prompt，粘贴到WorkBuddy'); }catch(e){}
    }
    waitForAiResult(board.code, sid);
  }catch(e){
    btn.classList.remove('analyzing');
    btn.querySelector('.skill-status').textContent='❌';
    toast('触发失败: '+e.message);
  }
}

// 等待AI分析结果
let _aiWaiting = {};
function waitForAiResult(code, skillId){
  const key = code+':'+skillId;
  const panel = document.getElementById('ai-result-panel');
  const content = document.getElementById('ai-result-content');
  panel.style.display='block';
  content.innerHTML='<div style="padding:8px;color:#f39c12;font-size:11px">🔄 AI 分析中...</div>';
  let tries = 0;
  const poll = setInterval(async()=>{
    tries++;
    if(tries > 30){ clearInterval(poll); content.innerHTML+='<div style="color:#ef5350;font-size:10px">超时未收到结果</div>'; return; }
    try{
      const r = await fetch(API+'/api/ai/result/'+code);
      const j = await r.json();
      if(j.summary){
        clearInterval(poll);
        renderAiResult(j);
        document.querySelectorAll('.skill-btn').forEach(b=>{
          if(b.dataset.sid===skillId){ b.classList.remove('analyzing'); b.classList.add('done'); b.querySelector('.skill-status').textContent='✅'; }
        });
      }
    }catch(e){}
  }, 2000);
  _aiWaiting[key] = poll;
}

// SSE推送的AI结果直接渲染
function renderAiResultAiEvent(data){
  const result = typeof data === 'string' ? JSON.parse(data) : data;
  renderAiResult(result);
  document.querySelectorAll('.skill-btn').forEach(b=>{
    if(b.dataset.sid===result.skill_id){
      b.classList.remove('analyzing'); b.classList.add('done');
      b.querySelector('.skill-status').textContent='✅';
    }
  });
}

// 渲染AI结论到右侧面板
function renderAiResult(r){
  const panel = document.getElementById('ai-result-panel');
  const content = document.getElementById('ai-result-content');
  if(!r || !r.summary){ return; }
  panel.style.display='block';
  const dir = r.direction || 'neutral';
  const dirLabel = dir==='bullish'?'看涨🐂':dir==='bearish'?'看跌🐻':'中性➡️';
  const confidence = Math.round((r.confidence||0.5)*100);
  let h = '';
  h += '<div style="margin-bottom:6px"><span class="ai-result-direction '+dir+'">'+dirLabel+'</span><span class="ai-result-confidence">置信度 '+confidence+'%</span></div>';
  h += '<div class="ai-result-summary">'+escHtml(r.summary)+'</div>';
  if((r.key_levels && (r.key_levels.support?.length || r.key_levels.resistance?.length)) || (r.annotations && r.annotations.length)){
    h += '<div class="ai-result-levels">';
    if(r.key_levels){
      if(r.key_levels.support?.length) h += '<div class="ai-level-box support">支撑<br><b>'+r.key_levels.support.join(', ')+'</b></div>';
      if(r.key_levels.resistance?.length) h += '<div class="ai-level-box resistance">阻力<br><b>'+r.key_levels.resistance.join(', ')+'</b></div>';
    }
    h += '</div>';
  }
  if(r.operation && r.operation.suggestion){
    h += '<div class="ai-result-operation"><b>操作建议:</b> '+escHtml(r.operation.suggestion);
    if(r.operation.entry) h += '<br>入场: ¥'+r.operation.entry;
    if(r.operation.stop_loss) h += ' | 止损: ¥'+r.operation.stop_loss;
    if(r.operation.target) h += ' | 目标: ¥'+r.operation.target;
    h += '</div>';
  }
  if(r.risk_warning){
    h += '<div class="ai-result-risk">⚠️ '+escHtml(r.risk_warning)+'</div>';
  }
  if(r.annotations && r.annotations.length){
    h += '<div style="margin-top:6px;font-size:10px;color:#787b86">已标注 '+r.annotations.length+' 个信号到K线图</div>';
  }
  content.innerHTML=h;
  const sp=document.getElementById('skill-panel'); sp.classList.add('expanded');
  // 保存到历史
  saveAnalysisRecord(r);
  if(r.annotations && pro && pro.createOverlay){
    drawAiAnnotations(r.annotations);
  }
}

// 保存分析记录
function saveAnalysisRecord(record){
  record.id = 'ar_' + Date.now();
  record.createdAt = new Date().toISOString();
  _analysisHistory.unshift(record);
  if(_analysisHistory.length > 50) _analysisHistory = _analysisHistory.slice(0, 50);
  try{ localStorage.setItem(_historyKey, JSON.stringify(_analysisHistory)); }catch(e){}
  renderAnalysisHistory();
}

function clearAiResult(){
  if(!store.selected) return;
  fetch(API+'/api/ai/result/'+store.selected.code,{method:'POST'}).catch(()=>{});
  document.getElementById('ai-result-panel').style.display='none';
  if(pro && pro.removeOverlay){ pro.removeOverlay({name:'ai_signals'}); }
}

// K线图AI标注
function drawAiAnnotations(annotations){
  if(!pro || !pro.createOverlay) return;
  const points = annotations.map(a => ({
    timestamp: a.timestamp || (a.date ? new Date(a.date).getTime() : Date.now()),
    value: a.price || a.value || 0,
    text: a.note || a.type || '',
    type: a.type || 'signal'
  }));
  try{
    pro.removeOverlay({name:'ai_signals'});
    pro.createOverlay({name:'ai_signals', points:points, styles:{color:'#f39c12',textColor:'#fff',size:6}});
  }catch(e){ console.warn('createOverlay failed:', e); }
}
function showAddSkill(){
  const box=document.getElementById('modal-box');
  box.innerHTML='<h3>添加AI技能</h3>'+
    '<label>技能名称 <input id="skill-name" style="width:100%;padding:6px;border:1px solid #2a2e39;border-radius:3px;background:#131722;color:#d1d4dc;font-size:12px" placeholder="如：逐K分析"/></label>'+
    '<label>分析提示词 <textarea id="skill-prompt" rows="4" style="width:100%;padding:6px;border:1px solid #2a2e39;border-radius:3px;background:#131722;color:#d1d4dc;font-size:11px" placeholder="支持 {name} {code} 变量，如：请分析{name}板块({code})的走势和信号"></textarea></label>'+
    '<label>关联WorkBuddy技能 <input id="skill-workbuddy" style="width:100%;padding:6px;border:1px solid #2a2e39;border-radius:3px;background:#131722;color:#d1d4dc;font-size:12px" placeholder="如：量价顶部预警（留空则仅复制提示词）"/></label>'+
    '<div><button class="modal-btn" onclick="doAddSkill()">添加</button><button class="modal-btn" style="margin-left:8px;background:#434651;border-color:#434651" onclick="closeModal()">取消</button></div>';
  showModal();
}
function doAddSkill(){
  const name=document.getElementById('skill-name').value.trim();
  const prompt=document.getElementById('skill-prompt').value.trim()||'请分析{name}板块({code})';
  const wb=document.getElementById('skill-workbuddy').value.trim();
  if(!name){toast('请输入技能名称');return;}
  const id='sk_'+Date.now();
  store._skills.push({id:id, name:name, label:name+(wb?'('+wb+')':''), prompt:prompt.replace('{name}','{name}').replace('{code}','{code}'), workbuddy:wb});
  localStorage.setItem('ai_skills',JSON.stringify(store._skills));
  renderSkills();closeModal();toast('已添加技能: '+name);
}
// WorkBuddy Hook 可用性检测
async function detectWorkBuddyHook(){
  try{
    // 尝试调用 WorkBuddy Hook 配置检测端点
    // WorkBuddy Hooks 通过 HTTP 推送到面板的 /api/ai/result
    // 这里检测本地5000端口是否可达（实际部署时WorkBuddy和面板在同一台机器）
    const r = await fetch('/api/health', {method:'GET'});
    if(r.ok){
      console.log('[WorkBuddy] 面板运行正常');
      // 尝试读取WorkBuddy配置文件中的hooks设置
      try{
        const hooksResp = await fetch('/api/hooks/status', {method:'GET'});
        if(hooksResp.ok){
          const hooksData = await hooksResp.json();
          if(hooksData.hook_url){
            console.log('[WorkBuddy] Hook目标:', hooksData.hook_url);
            return { available: true, hookUrl: hooksData.hook_url };
          }
        }
      }catch(e){}
      return { available: true, hookUrl: null };
    }
  }catch(e){
    console.warn('[WorkBuddy] 面板连接失败:', e);
  }
  return { available: false, hookUrl: null };
}

// 分析历史记录
function loadAnalysisHistory(){
  try{
    const s = localStorage.getItem(_historyKey);
    _analysisHistory = s ? JSON.parse(s) : [];
  }catch(e){ _analysisHistory = []; }
}

function renderAnalysisHistory(){
  const container = document.getElementById('ai-history-list');
  if(!container) return;
  if(_analysisHistory.length === 0){
    container.innerHTML = '<div style="padding:6px 10px;color:#434651;font-size:11px">暂无分析记录</div>';
    return;
  }
  let h = '<div style="font-size:9px;color:#434651;margin-bottom:4px">最近分析: ' + _analysisHistory.length + '条</div>';
  _analysisHistory.slice(0, 10).forEach(r => {
    const dir = r.direction || 'neutral';
    const dirIcon = dir === 'bullish' ? '🐂' : dir === 'bearish' ? '🐻' : '➡️';
    const conf = Math.round((r.confidence || 0) * 100);
    h += '<div class="ai-history-item" style="padding:4px 10px;border-bottom:1px solid #1e2230;cursor:pointer" onclick="replayAnalysisRecord(\''+r.id+'\')">'+
      '<span style="font-size:10px">'+dirIcon+' '+r.board_name+'</span>'+
      '<span style="font-size:9px;color:#787b86;float:right">'+r.createdAt.slice(5,16)+'</span>'+
      '<span style="font-size:9px;color:'+(dir==='bullish'?'#ef5350':dir==='bearish'?'#26a69a':'#787b86')+'">'+conf+'%</span>'+
      '</div>';
  });
  container.innerHTML = h;
}

function replayAnalysisRecord(id){
  const record = _analysisHistory.find(r => r.id === id);
  if(!record) return;
  // 重新渲染结论
  renderAiResult(record);
  // 如果有K线数据，加载对应板块
  if(record.board_code && store.selected && store.selected.code === record.board_code){
    drawAiAnnotations(record.annotations || []);
  }
}

// ===== 搜索相关变量定义（不重复声明，在顶部已定义） =====
let _searchIndex = [];

// ===== 8. 增强搜索（个股+指数+板块，拼音匹配，搜索历史） =====

// 搜索历史（localStorage）
const _searchHistoryKey = 'board_app_search_history';
let _searchHistory = [];

function loadSearchHistory(){
  try{
    const s = localStorage.getItem(_searchHistoryKey);
    _searchHistory = s ? JSON.parse(s) : [];
  }catch(e){ _searchHistory=[]; }
}
function saveSearchHistory(){
  try{
    localStorage.setItem(_searchHistoryKey, JSON.stringify(_searchHistory.slice(0,30)));
  }catch(e){}
}
function addSearchHistory(code, name, type, category){
  _searchHistory = _searchHistory.filter(h => h.code !== code);
  _searchHistory.unshift({code, name, type, category, time: Date.now()});
  _searchHistory = _searchHistory.slice(0,30);
  saveSearchHistory();
}

// 类型颜色/标签映射
const _typeStyles = {
  'stock':    {color:'#26a69a', label:'个股'},
  'index':    {color:'#42a5f5', label:'指数'},
  'hk_index': {color:'#7e57c2', label:'港股'},
  'industry': {color:'#ff7043', label:'行业'},
  'concept':  {color:'#ffb74d', label:'概念'},
};

// 类型 → datafeed type 映射
function searchTypeToFeedType(type){
  return type || 'index';
}

// 类型 → selectBoard 所需 type
function searchTypeToBoardType(type, code){
  if(type === 'stock') return 'stock';
  if(type === 'hk_index') return 'hk_index';
  if(type === 'index') return 'index';
  // BK代码的板块
  if(code && code.startsWith('BK')) return type || 'concept';
  return type || 'concept';
}

const si=document.getElementById('search-input'), sr=document.getElementById('search-results');
let sIdx=-1, _searchTimer=null;

// 渲染搜索项 HTML
function renderSearchItem(item, i){
  const ts = _typeStyles[item.type] || {color:'#787b86', label:item.category||'其它'};
  const dc = item.display_code || item.code;
  return '<div class="search-item" data-idx="'+i+'">'+
    '<span class="search-tag" style="background:'+ts.color+'20;color:'+ts.color+';border:1px solid '+ts.color+'40">'+ts.label+'</span>'+
    '<span class="search-name">'+escHtml(item.name)+'</span>'+
    '<span class="search-code">'+escHtml(dc)+'</span>'+
    '<span class="search-pinyin" style="color:#434651;font-size:10px;margin-left:auto">'+escHtml(item.initials||'')+'</span>'+
    '</div>';
}

// 渲染搜索历史
function renderSearchHistory(){
  loadSearchHistory();
  if(!_searchHistory.length) return '';
  return '<div class="search-history-header">最近搜索</div>'+
    _searchHistory.slice(0,8).map((h,i) => {
      const ts = _typeStyles[h.type] || {color:'#787b86', label:h.category||'其它'};
      return '<div class="search-item search-history-item" data-history="'+i+'">'+
        '<span class="search-tag" style="background:'+ts.color+'20;color:'+ts.color+';border:1px solid '+ts.color+'40">'+ts.label+'</span>'+
        '<span class="search-name">'+escHtml(h.name)+'</span>'+
        '<span class="search-code">'+escHtml(h.display_code||h.code)+'</span>'+
        '<span style="color:#434651;font-size:10px;margin-left:auto">⌛</span></div>';
    }).join('');
}

si.onfocus = function(){
  if(!si.value.trim()){
    // 显示搜索历史
    sr.innerHTML = renderSearchHistory();
    if(_searchHistory.length) sr.classList.add('show');
    else sr.classList.remove('show');
  }
};

si.oninput = function(){
  const q = si.value.trim();
  if(!q){
    sr.innerHTML = renderSearchHistory();
    if(_searchHistory.length) sr.classList.add('show');
    else sr.classList.remove('show');
    sIdx = -1;
    return;
  }
  
  // 清除旧定时器
  if(_searchTimer) clearTimeout(_searchTimer);
  
  // 防抖 150ms
  _searchTimer = setTimeout(async () => {
    try {
      // 构建历史code列表用于置顶
      const historyCodes = _searchHistory.map(h => h.code).join(',');
      const r = await fetch(API+'/api/search?q='+encodeURIComponent(q)+
        (historyCodes ? '&history='+encodeURIComponent(historyCodes) : ''));
      const resp = await r.json();
      const matches = resp.data || [];
      
      if(!matches.length){
        sr.innerHTML = '<div style="padding:10px;color:#434651;font-size:11px;text-align:center">无匹配结果</div>';
        sr.classList.add('show');
        sIdx = -1;
        window._sm = [];
        return;
      }
      
      sr.innerHTML = matches.map((m,i) => renderSearchItem(m,i)).join('');
      sr.classList.add('show');
      sIdx = -1;
      window._sm = matches;
    } catch(e) {
      console.warn('[搜索] 请求失败:', e);
      sr.classList.remove('show');
    }
  }, 150);
};

function searchPick(i){
  const items = window._sm;
  if(!items || i < 0 || i >= items.length) return;
  const m = items[i];
  if(!m) return;
  
  // 记录搜索历史
  addSearchHistory(m.code, m.name, m.type, m.category);
  
  // 加载对应数据
  const boardType = searchTypeToBoardType(m.type, m.code);
  selectBoard(m.name, m.code, boardType, null);
  sr.classList.remove('show');
  si.value = '';
}

// 点击历史项
function searchPickHistory(i){
  loadSearchHistory();
  const h = _searchHistory[i];
  if(!h) return;
  const boardType = searchTypeToBoardType(h.type, h.code);
  selectBoard(h.name, h.code, boardType, null);
  sr.classList.remove('show');
  si.value = '';
}

// 委托点击事件（搜索项和历史项）
sr.addEventListener('mousedown', function(e){
  const item = e.target.closest('.search-item');
  if(!item) return;
  const idx = item.dataset.idx;
  const histIdx = item.dataset.history;
  if(idx !== undefined) searchPick(parseInt(idx));
  else if(histIdx !== undefined) searchPickHistory(parseInt(histIdx));
});

si.onkeydown = function(e){
  const items = sr.querySelectorAll('.search-item');
  if(!sr.classList.contains('show') || items.length === 0) return;
  
  if(e.key === 'ArrowDown'){
    e.preventDefault();
    if(sIdx < items.length - 1){
      if(sIdx >= 0) items[sIdx].classList.remove('selected');
      sIdx++;
      items[sIdx].classList.add('selected');
      const t = items[sIdx].offsetTop, bh = sr.clientHeight;
      if(t + items[sIdx].offsetHeight > sr.scrollTop + bh) sr.scrollTop = t + items[sIdx].offsetHeight - bh;
      else if(t < sr.scrollTop) sr.scrollTop = t;
    }
  } else if(e.key === 'ArrowUp'){
    e.preventDefault();
    if(sIdx > 0){
      items[sIdx].classList.remove('selected');
      sIdx--;
      items[sIdx].classList.add('selected');
      const t = items[sIdx].offsetTop;
      if(t < sr.scrollTop) sr.scrollTop = t;
      else if(t + items[sIdx].offsetHeight > sr.scrollTop + sr.clientHeight)
        sr.scrollTop = t + items[sIdx].offsetHeight - sr.clientHeight;
    }
  } else if(e.key === 'Enter'){
    e.preventDefault();
    if(sIdx >= 0 && items[sIdx]){
      items[sIdx].click();
    } else if(items.length > 0){
      items[0].click();
    }
  } else if(e.key === 'Escape'){
    sr.classList.remove('show');
    si.blur();
  }
};

document.addEventListener('click', function(e){
  if(!e.target.closest('#search-wrap')) sr.classList.remove('show');
});

// 初始化搜索历史
loadSearchHistory();

// ==== SSE 自动刷新（数据更新+AI分析+防抖） ====
(function(){
  const es = new EventSource('/api/events');
  let _sseRefreshTimer = null;
  
  // 数据更新
  es.addEventListener('data_updated', () => {
    console.log('[SSE] 数据已更新');
    toast('数据已更新');
    clearTimeout(_sseRefreshTimer);
    _sseRefreshTimer = setTimeout(() => {
      if (store.selected && pro && pro.setSymbol) {
        pro.setSymbol({
          ticker: store.selected.code, name: store.selected.name,
          type: store.selected.type, market: 'A', priceCurrency: 'CNY'
        });
      }
    }, 500);
  });
  
  es.addEventListener('data_updating', () => { toast('数据更新中...'); });
  
  // AI分析开始
  es.addEventListener('ai_analyzing', (e) => {
    try{
      const d = JSON.parse(e.data);
      toast('AI开始分析: ' + d.board_name);
      document.querySelectorAll('.skill-btn').forEach(b=>{
        if(b.dataset.sid===d.skill_id){
          b.classList.add('analyzing');
          b.querySelector('.skill-status').textContent='⏳';
        }
      });
    }catch(e){}
  });
  
  // AI分析完成
  es.addEventListener('ai_result', (e) => {
    try{
      const d = JSON.parse(e.data);
      renderAiResult(d);
    }catch(e){ console.warn('ai_result parse error:', e); }
  });
  
  // 信号更新
  es.addEventListener('signals_updated', (e) => {
    try{
      const d = JSON.parse(e.data);
      if(store.selected && store.selected.code===d.board_code){
        loadSignals(d.board_code);
      }
    }catch(e){}
  });
  
  es.onerror = () => console.warn('[SSE] 连接断开');
  setTimeout(() => { if (store.selected) checkDataFreshness(); }, 2000);
})();

// ==== 数据新鲜度检查 ====
async function checkDataFreshness(){
  if (!store.selected) return;
  try {
    const r = await fetch(API+'/api/kline/'+store.selected.type+'/'+store.selected.code
      +'?name='+encodeURIComponent(store.selected.name)+'&period=daily');
    const j = await r.json();
    if (j.last_date) {
      const today = new Date();
      const lastDate = new Date(j.last_date);
      const diffDays = (today - lastDate) / 86400000;
      if (diffDays > 3) {
        toast('⚠️ 数据可能已过期（最后更新：'+j.last_date+'）');
      } else if (j.last_date !== today.toISOString().slice(0,10) && today.getHours() >= 15) {
        // 交易日已收盘但数据不是今天的，提示刷新
        showToastBar('数据可能不是最新的，点击 <a href="#" onclick="forceRefresh()">强制刷新</a>');
      }
    }
  } catch(e) {}
}

// ==== 强制刷新 ====
function forceRefresh(){
  closeCtx();
  toast('正在强制刷新...');
  fetch(API+'/api/update/force', {method:'POST'})
    .then(r=>r.json())
    .then(j=>{
      if(j.ok) toast('全量更新已触发，请等待完成');
      document.getElementById('refresh-btn') && (document.getElementById('refresh-btn').disabled = false);
    })
    .catch(()=>toast('触发失败'));
}

// 在工具栏添加刷新按钮
(function(){
  const tb = document.getElementById('toolbar');
  if(!tb) return;
  const btn = document.createElement('button');
  btn.id = 'refresh-btn';
  btn.innerHTML = '↻';
  btn.title = '强制刷新数据';
  btn.style.cssText = 'padding:0 8px;border:none;background:transparent;color:#787b86;font-size:14px;cursor:pointer;flex-shrink:0';
  btn.onclick = forceRefresh;
  btn.onmouseover = function(){this.style.color='#d1d4dc'};
  btn.onmouseout = function(){this.style.color='#787b86'};
  tb.appendChild(btn);
})();

// ===== 9. 分割条 =====
let drg=false;
document.getElementById('splitter').onmousedown=e=>{drg=true;e.preventDefault();};
document.onmousemove=e=>{if(!drg)return;const w=Math.max(200,Math.min(400,e.clientX));document.getElementById('nav-panel').style.width=w+'px';};
document.onmouseup=()=>{drg=false;};

// ===== 10. 弹窗 =====
function showModal(){document.getElementById('modal-overlay').classList.add('show');}
function closeModal(){document.getElementById('modal-overlay').classList.remove('show');}
document.getElementById('modal-overlay').addEventListener('click',function(e){if(e.target===this)closeModal();});

// ===== 11. Utils =====
function escHtml(s){const d=document.createElement('div');d.textContent=s||'';return d.innerHTML;}
function escAttr(s){return (s||'').replace(/'/g,"\\'").replace(/"/g,'&quot;');}

// ===== 启动（分类 → 拼音索引 + 技能 + Pro 常驻） =====
// 1. 注入预置技能
ensureDefaultSkills();
// 2. 渲染技能列表
renderSkills();
// 3. 加载分析历史
loadAnalysisHistory();
renderAnalysisHistory();
// 4. 检测WorkBuddy Hook
detectWorkBuddyHook();
// 5. 加载分类
loadClassification().then(() => {
  console.log('[启动] 板块分类加载完成');
});
// 页面加载后立即初始化 Pro（常驻显示）
document.addEventListener('DOMContentLoaded', () => {
  setTimeout(initPro, 100);
});
if (document.readyState === 'complete' || document.readyState === 'interactive') {
  setTimeout(initPro, 200);
}
// 页面加载后预加载第一个板块
setTimeout(preloadFirstBoard, 500);
</script>
</body>
</html>
