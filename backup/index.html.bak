<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Stock Canvas</title>
<link rel="stylesheet" href="https://unpkg.com/@klinecharts/pro/dist/klinecharts-pro.css">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','Microsoft YaHei',sans-serif;background:#131722;color:#d1d4dc;height:100vh;overflow:hidden}
#app{display:flex;flex-direction:column;height:100%}
#toolbar{display:flex;align-items:center;gap:10px;padding:6px 14px;border-bottom:1px solid #2a2e39;background:#1a1e29;flex-shrink:0;font-size:12px}
#main{display:flex;flex:1;overflow:hidden}
/* 左侧 */
#nav-panel{width:280px;min-width:200px;max-width:400px;border-right:1px solid #2a2e39;overflow-y:auto;flex-shrink:0}
.nav-header{padding:7px 10px;font-size:11px;font-weight:500;border-bottom:1px solid #2a2e39;background:#1a1e29;position:sticky;top:0;z-index:1}
.cat-item{padding:5px 10px;display:flex;align-items:center;border-bottom:1px solid #1e2230;cursor:pointer;font-size:12px;user-select:none}
.cat-item:hover{background:#1e2230}
.cat-item .arrow{width:14px;font-size:9px;color:#434651;margin-right:4px}
.cat-item .count{font-size:10px;color:#434651;margin-left:auto}
.cat-item.active{background:#2962ff;color:#fff}
.cat-item.active .count{color:#a0b4ff}
.collapsed{display:none}
.board-item{padding:4px 10px 4px 22px;font-size:11px;border-bottom:1px solid #1a1e2e;cursor:pointer;display:flex;justify-content:space-between;user-select:none}
.board-item:hover{background:#1e2230}
.board-item.active{background:#2a2e39}
.board-item .cons-wrap{display:none}
.board-item.expanded .cons-wrap{display:block}
.cons-list{background:#161a23;padding:2px 0}
.cons-item{display:flex;padding:2px 24px 2px 30px;font-size:10px;color:#787b86;gap:8px;cursor:pointer}
.cons-item:hover{color:#d1d4dc;background:#1e222d}
.cons-item .cons-code{color:#434651;min-width:56px}
.cons-item .cons-name{flex:1;overflow:hidden;text-overflow:ellipsis}
.board-item .code{font-size:9px;color:#434651}
.board-item.type-i{color:#4fc3f7}
.board-item.type-c{color:#ffb74d}
.board-item.type-i:hover{background:#0d2b45}
.board-item.type-c:hover{background:#2a1f0a}
.board-item .board-chg{font-size:9px;margin-left:auto;padding-left:4px;font-weight:500;min-width:36px;text-align:right}
.board-item .board-chg.up{color:#ef5350}.board-item .board-chg.down{color:#26a69a}
.sort-btn{font-size:9px;padding:1px 6px;border:1px solid #2a2e39;border-radius:3px;cursor:pointer;color:#787b86;margin-left:6px;background:transparent}
.sort-btn:hover{color:#d1d4dc;border-color:#787b86}
.sort-btn.active{color:#2962ff;border-color:#2962ff}
.fcons-pct{font-size:9px;text-align:right;min-width:36px;font-weight:500}
.fcons-pct.up{color:#ef5350}.fcons-pct.down{color:#26a69a}
#splitter{cursor:col-resize}
#splitter:hover{background:#2962ff}
/* 右侧 */
#content{flex:1;display:flex;flex-direction:column;overflow:hidden}
#price-bar{display:flex;align-items:center;gap:12px;padding:5px 14px;border-bottom:1px solid #2a2e39;font-size:11px;flex-shrink:0;color:#787b86}
#price-bar .name{font-size:13px;font-weight:500;color:#d1d4dc}
#price-bar .price{font-size:20px;font-weight:400}
#price-bar .price.up{color:#ef5350}#price-bar .price.down{color:#26a69a}
/* 图表工具栏 — 常驻样式 */
#chart-bar{display:flex;align-items:center;gap:3px;padding:2px 8px;border-bottom:1px solid #2a2e39;background:#1a1e29;flex-shrink:0;font-size:10px;flex-wrap:wrap}
.chart-bar-btn{padding:2px 6px;border:1px solid #2a2e39;border-radius:3px;cursor:pointer;background:transparent;color:#787b86;font-size:10px;white-space:nowrap}
.chart-bar-btn:hover,.chart-bar-btn.active{background:#2962ff;color:#fff;border-color:#2962ff}
.chart-bar-btn.drawing{color:#f39c12;border-color:#5a4410}
.chart-bar-btn.drawing:hover,.chart-bar-btn.drawing.active{background:#f39c12;color:#000;border-color:#f39c12}
.chart-bar-btn.vol-on{color:#26a69a;border-color:#1a5a4e}
.chart-bar-btn.vol-on:hover{background:#26a69a;color:#fff}
.chart-bar-sep{width:1px;height:18px;background:#2a2e39;margin:0 4px}
.chart-bar-label{color:#434651;font-size:10px;margin-right:2px}
#chart-box{flex:1;min-height:0;position:relative}
#chart-box .placeholder{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:#434651;font-size:14px;text-align:center}
/* 指标浮层 — 图表右上角 */
#indicator-float{position:absolute;top:6px;right:8px;z-index:10;display:flex;gap:4px;flex-wrap:wrap;max-width:50%;justify-content:flex-end}
.ind-float-btn{display:inline-flex;align-items:center;gap:2px;padding:2px 6px 2px 8px;border-radius:3px;font-size:9px;color:#d1d4dc;background:rgba(26,30,41,0.85);border:1px solid #2a2e39;cursor:default;white-space:nowrap}
.ind-float-btn .ind-close{color:#ef5350;cursor:pointer;margin-left:3px;padding:0 2px;font-size:11px}
.ind-float-btn .ind-close:hover{color:#ff4444}
/* 搜索 */
#search-wrap{position:fixed;bottom:16px;right:16px;z-index:100;width:140px;height:28px}
#search-input{width:100%;height:100%;border:none;background:#1e222d;color:#d1d4dc;font-size:11px;padding:0 8px;outline:none;border-radius:3px}
#search-input:focus{background:#252a36}
#search-results{position:absolute;bottom:100%;right:0;width:320px;background:#1e222d;border:1px solid #2a2e39;border-radius:6px;max-height:360px;overflow-y:auto;display:none;z-index:999;margin-bottom:6px;padding:4px 0}
#search-results.show{display:block}
.search-item{display:flex;align-items:center;gap:6px;padding:6px 10px;cursor:pointer;font-size:12px;line-height:1.4}
.search-item:hover,.search-item.selected{background:#2a2e39}
.search-tag{font-size:9px;padding:1px 5px;border-radius:3px;flex-shrink:0;font-weight:500}
.search-name{color:#d1d4dc;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.search-code{color:#787b86;font-size:10px;flex-shrink:0}
.search-history-header{padding:6px 10px 4px;color:#434651;font-size:10px;border-bottom:1px solid #2a2e39;margin-bottom:2px}
#search-input{width:240px;padding:6px 10px;border:1px solid #2a2e39;border-radius:4px;background:#1a1e29;color:#d1d4dc;font-size:12px;outline:none}
#search-input:focus{border-color:#2962ff}
#search-results{position:absolute;bottom:36px;right:0;width:280px;max-height:320px;overflow-y:auto;background:#1a1e29;border:1px solid #2a2e39;border-radius:4px;display:none}
#search-results.show{display:block}
.search-item{padding:4px 10px;cursor:pointer;font-size:11px;display:flex;justify-content:space-between}
.search-item:hover,.search-item.selected{background:#2962ff}
/* KLineChart Pro 容器高度 */
.klinecharts-pro{height:100%!important;}
.klinecharts-pro-content{height:calc(100% - 38px)!important;}
#pro-container{width:100%;height:100%;position:relative;}
/* 指数快捷栏 */
#index-bar{display:flex;align-items:stretch;gap:0;overflow-x:auto;overflow-y:hidden;flex:1;scrollbar-width:none;cursor:grab;user-select:none}
#index-bar::-webkit-scrollbar{display:none}
#index-bar:active{cursor:grabbing}
.idx-group{display:flex;align-items:stretch;border-right:1px solid #2a2e39;padding:0 2px}
.idx-group:last-child{border-right:none}
.idx-label{display:flex;align-items:center;padding:0 3px;color:#434651;font-size:9px;font-weight:600;white-space:nowrap}
.idx-item{display:flex;align-items:center;gap:2px;padding:0 5px;cursor:pointer;border-radius:2px;position:relative;transition:all 0.1s;white-space:nowrap;font-size:10px;height:100%}
.idx-item:hover{background:#2a2e39}
.idx-item.active{background:#2962ff}
.idx-item .name{color:#d1d4dc;font-size:10px}
.idx-item .price{font-size:10px;font-weight:600;min-width:38px;text-align:right;font-variant-numeric:tabular-nums}
.idx-item .price.up{color:#ef5350}.idx-item .price.down{color:#26a69a}.idx-item .price.flat{color:#787b86}
.idx-del{position:absolute;top:-2px;right:-2px;width:12px;height:12px;border-radius:50%;background:#ef5350;color:#fff;font-size:7px;line-height:12px;text-align:center;cursor:pointer;display:none;z-index:10;border:1px solid #131722}
.idx-item:hover .idx-del{display:block}
/* 右键菜单 */
#ctx-menu{display:none;position:fixed;background:#1a1e29;border:1px solid #2a2e39;border-radius:4px;z-index:200;min-width:160px;padding:4px 0}
#ctx-menu.show{display:block}
.ctx-item{padding:5px 12px;font-size:11px;color:#d1d4dc;cursor:pointer}
.ctx-item:hover{background:#2962ff}
.ctx-sep{height:1px;background:#2a2e39;margin:3px 8px}
/* 弹窗 */
#modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:300}
#modal-overlay.show{display:flex;align-items:center;justify-content:center}
#modal-box{background:#1a1e29;border:1px solid #2a2e39;border-radius:8px;padding:20px;min-width:320px;max-width:480px;max-height:80vh;overflow-y:auto}
#modal-box h3{font-size:14px;margin-bottom:12px;color:#d1d4dc}
#modal-box label{display:block;font-size:11px;color:#787b86;margin:8px 0 4px}
#modal-box input[type=color]{width:40px;height:28px;border:1px solid #2a2e39;border-radius:3px;background:transparent;cursor:pointer;vertical-align:middle}
#modal-box input[type=number]{width:60px;padding:4px 6px;border:1px solid #2a2e39;border-radius:3px;background:#131722;color:#d1d4dc;font-size:11px}
#modal-box .modal-btn{padding:5px 14px;border:1px solid #2962ff;border-radius:3px;cursor:pointer;background:#2962ff;color:#fff;font-size:11px;margin-top:12px}
#modal-box .modal-btn:hover{background:#1a4fbf}
/* 右侧栏 */
#skill-panel{width:180px;min-width:180px;border-left:1px solid #2a2e39;overflow-y:auto;flex-shrink:0;font-size:12px;max-width:320px;transition:width .3s}
#skill-panel.expanded{width:320px;min-width:320px}
.skill-cat{padding:7px 10px;font-size:11px;font-weight:500;border-bottom:1px solid #2a2e39;background:#1a1e29;display:flex;justify-content:space-between;align-items:center}
.skill-cat .add-btn{color:#2962ff;cursor:pointer;font-size:14px;padding:0 4px}
.skill-cat .add-btn:hover{color:#4fc3f7}
.skill-item{padding:5px 10px;border-bottom:1px solid #1e2230}
.skill-item .skill-label{font-size:11px;display:block;margin-bottom:4px}
.skill-btn{width:100%;padding:4px;border:1px solid #2962ff;border-radius:3px;background:transparent;color:#2962ff;font-size:11px;cursor:pointer;text-align:left;padding-left:8px;transition:all .2s;position:relative}
.skill-btn:hover{background:#2962ff;color:#fff}
.skill-btn.analyzing{border-color:#f39c12;color:#f39c12;background:rgba(243,156,18,.1)}
.skill-btn.done{border-color:#26a69a;color:#26a69a;background:rgba(38,166,154,.1)}
.skill-btn .skill-status{font-size:9px;float:right;margin-top:2px}

/* AI结果面板扩展 */
#ai-result-panel{padding:8px 10px;border-top:2px solid #2962ff;background:#1a1e29}
#ai-result-panel .ai-result-summary{font-size:11px;color:#d1d4dc;line-height:1.5;max-height:200px;overflow-y:auto;margin-bottom:8px;white-space:pre-wrap;word-wrap:break-word}
#ai-result-panel .ai-result-direction{display:inline-block;padding:2px 6px;border-radius:3px;font-size:10px;font-weight:600;margin-right:4px}
#ai-result-panel .ai-result-direction.bullish{background:#ef5350;color:#fff}
#ai-result-panel .ai-result-direction.bearish{background:#26a69a;color:#fff}
#ai-result-panel .ai-result-direction.neutral{background:#434651;color:#fff}
#ai-result-panel .ai-result-confidence{font-size:10px;color:#787b86}
#ai-result-panel .ai-result-levels{display:flex;gap:6px;margin-top:6px;font-size:10px}
#ai-result-panel .ai-level-box{flex:1;padding:4px 6px;border-radius:3px;text-align:center}
#ai-result-panel .ai-level-box.support{background:rgba(38,166,154,.15);color:#26a69a}
#ai-result-panel .ai-level-box.resistance{background:rgba(239,83,80,.15);color:#ef5350}
#ai-result-panel .ai-result-operation{font-size:11px;color:#d1d4dc;margin-top:6px;padding:6px;background:#131722;border-radius:3px;line-height:1.4}
#ai-result-panel .ai-result-risk{font-size:10px;color:#787b86;margin-top:4px}
#ai-result-panel .ai-annotation-badge{display:inline-block;padding:1px 4px;border-radius:2px;font-size:9px;margin-right:2px}
#ai-result-panel .ai-annotation-badge.support{background:#26a69a;color:#fff}
#ai-result-panel .ai-annotation-badge.resistance{background:#ef5350;color:#fff}
#ai-result-panel .ai-annotation-badge.signal{background:#f39c12;color:#fff}

/* 分析历史 */
#ai-history-list{font-size:10px}
.ai-history-item:hover{background:#1e2230}
#ai-result-panel{padding:8px 10px;border-top:2px solid #2962ff;background:#1a1e29}
#ai-result-panel .ai-result-summary{font-size:11px;color:#d1d4dc;line-height:1.5;max-height:200px;overflow-y:auto;margin-bottom:8px;white-space:pre-wrap;word-wrap:break-word}
#ai-result-panel .ai-result-direction{display:inline-block;padding:2px 6px;border-radius:3px;font-size:10px;font-weight:600;margin-right:4px}
#ai-result-panel .ai-result-direction.bullish{background:#ef5350;color:#fff}
#ai-result-panel .ai-result-direction.bearish{background:#26a69a;color:#fff}
#ai-result-panel .ai-result-direction.neutral{background:#434651;color:#fff}
#ai-result-panel .ai-result-confidence{font-size:10px;color:#787b86}
#ai-result-panel .ai-result-levels{display:flex;gap:6px;margin-top:6px;font-size:10px}
#ai-result-panel .ai-level-box{flex:1;padding:4px 6px;border-radius:3px;text-align:center}
#ai-result-panel .ai-level-box.support{background:rgba(38,166,154,.15);color:#26a69a}
#ai-result-panel .ai-level-box.resistance{background:rgba(239,83,80,.15);color:#ef5350}
#ai-result-panel .ai-result-operation{font-size:11px;color:#d1d4dc;margin-top:6px;padding:6px;background:#131722;border-radius:3px;line-height:1.4}
#ai-result-panel .ai-result-risk{font-size:10px;color:#787b86;margin-top:4px}
#ai-result-panel .ai-annotation-badge{display:inline-block;padding:1px 4px;border-radius:2px;font-size:9px;margin-right:2px}
#ai-result-panel .ai-annotation-badge.support{background:#26a69a;color:#fff}
#ai-result-panel .ai-annotation-badge.resistance{background:#ef5350;color:#fff}
#ai-result-panel .ai-annotation-badge.signal{background:#f39c12;color:#fff}
.signal-row{padding:3px 10px;font-size:11px;border-bottom:1px solid #1e2230}
.signal-date{color:#434651}
.signal-badge{padding:0 4px;border-radius:2px;font-size:10px;margin:0 4px}
.signal-badge.buy{background:#ef5350;color:#fff}
.signal-badge.sell{background:#26a69a;color:#fff}
.toast{position:fixed;top:16px;left:50%;transform:translateX(-50%);background:#2962ff;color:#fff;padding:8px 20px;border-radius:4px;font-size:12px;z-index:500;opacity:0;transition:opacity .3s}
.toast.show{opacity:1}
.toast-bar{position:fixed;top:36px;left:50%;transform:translateX(-50%);background:#1e222d;border:1px solid #ef5350;border-radius:4px;color:#d1d4dc;font-size:11px;padding:4px 12px;z-index:999;display:none}
.toast-bar.show{display:block}
.toast-bar a{color:#2962ff;cursor:pointer;text-decoration:underline}
/* 二级浮层面板 */
#floating-cons{position:fixed;left:280px;top:36px;width:240px;max-height:calc(100vh - 60px);overflow-y:auto;background:#161a23;border:1px solid #2a2e39;border-radius:4px;z-index:200;display:none;font-size:11px;box-shadow:2px 2px 12px rgba(0,0,0,.4)}
#floating-cons.show{display:block}
#floating-cons .fcons-header{padding:6px 10px;color:#434651;font-size:10px;border-bottom:1px solid #2a2e39;position:sticky;top:0;background:#161a23;z-index:1}
#floating-cons .fcons-item{display:flex;padding:5px 10px;cursor:pointer;gap:6px;align-items:center}
#floating-cons .fcons-item:hover{background:#1e222d}
#floating-cons .fcons-item .fcons-code{color:#434651;min-width:56px}
#floating-cons .fcons-item .fcons-name{flex:1;overflow:hidden;text-overflow:ellipsis;color:#d1d4dc}
#floating-cons .fcons-item .fcons-cap{color:#434651;font-size:9px;text-align:right;min-width:40px}
#floating-cons .fcons-item .fcons-pct{color:#434651;font-size:9px;text-align:right;min-width:36px}
</style>
</head>
<body>
<div id="app">
  <div id="toolbar">
  <button class="tab-btn active" id="tab-classify">分类导航</button>
  <div id="index-bar"></div>
</div>

  <div id="main">
    <div id="nav-panel"><div class="nav-header">加载分类...</div></div>
    <div id="splitter"></div>
    <div id="content">
      <div id="pro-container">
        <div class="placeholder" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:#434651;font-size:14px;text-align:center">点击左侧板块查看K线</div>
      </div>
    </div>
<div id="skill-panel">
  <div class="skill-cat">技能市场 <span class="add-btn" onclick="showAddSkill()">＋</span></div>
  <div id="skill-list"></div>
  <div id="ai-result-panel" style="display:none">
    <div class="skill-cat">AI 分析结论 <span style="font-size:9px;color:#434651;cursor:pointer" onclick="clearAiResult()">清除</span></div>
    <div id="ai-result-content"></div>
  </div>
  <div class="skill-cat">分析历史 <span style="font-size:9px;color:#434651;cursor:pointer" onclick="loadAnalysisHistory()">刷新</span></div>
  <div id="ai-history-list" style="background:#131722;padding:6px 10px;color:#434651;font-size:11px">暂无分析记录</div>
  <div class="skill-cat">信号记录</div>
  <div id="signal-list" style="padding:6px 10px;color:#434651;font-size:11px">选中板块后显示</div>
</div>
  </div>
</div>
<div id="search-wrap">
  <input id="search-input" placeholder="搜索板块/代码">
  <div id="search-results"></div>
</div>
<div id="floating-cons"></div>
<div id="ctx-menu"></div>
<div id="modal-overlay"><div id="modal-box"></div></div>
<div id="toast" class="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/klinecharts@9.6.0/dist/klinecharts.min.js" onerror="injectCDNScripts()"></script>
<script src="https://cdn.jsdelivr.net/npm/@klinecharts/pro/dist/klinecharts-pro.umd.js" onerror="injectCDNScripts()"></script>
<script>
const store = { activeCat:null, selected:null, categoryData:null, _seq:0, _skills:[] };
let pro = null;
const API = '';
function toast(m){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');clearTimeout(t._t);t._t=setTimeout(()=>t.classList.remove('show'),2500);}
/* 预先声明所有可能被初始化函数引用的变量（避免TDZ） */
let _analysisHistory = [];
const _historyKey = 'ai_analysis_history';
let _lastClickBoard=null;
let _lastClickTime=0;
let _pendingSym=0;
let _preloadDone = {};
let _currentReqId = 0;
let _aiPanelCache = null;
let _navPanelScroll = 0;
let _idxBarDragEl = null;
let _pinyinData = {};
let _sm = null;
// 类型样式（顶部已定义，这里只引用）
const _chartLoadingTimers = {};
function showToastBar(html){let el=document.getElementById('toast-bar');if(!el){el=document.createElement('div');el.id='toast-bar';el.className='toast-bar';document.body.appendChild(el);}el.innerHTML=html;el.classList.add('show');clearTimeout(el._bt);el._bt=setTimeout(()=>el.classList.remove('show'),15000);}

// ===== 1. 分类（支持持久化+拼音排序） =====
async function loadClassification() {
  const p=document.getElementById('nav-panel');
  try {
    // 优先加载用户保存的分类，失败则回退到静态文件
    const r=await fetch(API+'/api/classification/load');
    store.categoryData=(await r.json()).categories;
    renderNav();
  } catch(e){p.innerHTML='<div class="nav-header" style="color:#ef5350">加载失败</div><div class="nav-item" onclick="loadClassification()">点此重试</div>';}
}

// 获取板块拼音排序键：取每个字的拼音首字母拼接
function _boardSortKey(name){
  if(!_pinyinData)return name;
  // 从本地搜索索引映射中查找
  const found = window._sm ? window._sm.find(s => s.name === name) : null;
  if(found && found.initials) return found.initials;
  // 从拼音数据中找任意匹配（旧版缓存兼容）
  for(const info of Object.values(_pinyinData)){
    if(info.name===name){
      return (info.initials||[]).join('');
    }
  }
  return name;
}

function renderNav(){
  const p=document.getElementById('nav-panel');
  let total=0; store.categoryData.forEach(c=>total+=c.boards.length);
  let h='<div class="nav-header">板块分类 <span style="font-size:10px;color:#434651">('+total+'个)</span><span class="sort-btn'+(store._sortBoardByChg?' active':'')+'" onclick="toggleBoardSort()">涨幅排序</span></div>';
  store.categoryData.forEach(cat=>{
    const id='cat_'+cat.name.replace(/[^a-zA-Z0-9\u4e00-\u9fff]/g,'_');
    const active=store.activeCat===cat.name?'active':'';
    // 按拼音首字母排序：行业内按行业排序，概念内按概念排序
    const sorted=[...cat.boards].sort((a,b)=>{
      const ka=_boardSortKey(a.name), kb=_boardSortKey(b.name);
      return ka<kb?-1:ka>kb?1:0;
    });
    h+='<div class="cat-item '+active+'" onclick="toggleCat(\''+id+'\',\''+escAttr(cat.name)+'\')"><span class="arrow">▶</span> '+escHtml(cat.name)+'<span class="count">'+cat.boards.length+'</span></div>';
    h+='<div class="collapsed" id="'+id+'">';
    sorted.forEach(b=>{
      const cls=b.type==='industry'?'type-i':'type-c';
      h+='<div class="board-item '+cls+'" data-code="'+b.code+'" data-type="'+b.type+'" data-name="'+escAttr(b.name)+'" data-chg="0" onclick="selectBoard(\''+escAttr(b.name)+'\',\''+b.code+'\',\''+b.type+'\',event)" onmouseenter="showConsPanel(\''+escAttr(b.name)+'\',\''+b.code+'\',\''+b.type+'\',event)" oncontextmenu="showBoardCtx(event,\''+escAttr(b.name)+'\',\''+b.code+'\',\''+b.type+'\')"><span>'+escHtml(b.name)+'</span><span class="board-chg" data-bchg="'+b.code+'"></span><span class="code">'+b.code+'</span></div>';
    });
    h+='</div>';
  });
  p.innerHTML=h;
}
function toggleCat(id,name){
  const el=document.getElementById(id); if(!el)return;
  const arrow=el.previousElementSibling.querySelector('.arrow');
  el.classList.toggle('collapsed');
  arrow.textContent=el.classList.contains('collapsed')?'▶':'▼';
  if(!el.classList.contains('collapsed')){
    store.activeCat=name;
    document.querySelectorAll('.cat-item.active').forEach(e=>e.classList.remove('active'));
    el.previousElementSibling.classList.add('active');
  } else store.activeCat=null;
}

// ===== 2. 右键菜单：板块分类 =====
let _ctxBoard=null;
function showBoardCtx(e,name,code,type){
  e.preventDefault();
  _ctxBoard={name,code,type};
  const cats=store.categoryData.filter(c=>c.name!=='其他');
  let h='<div class="ctx-item" style="color:#434651;cursor:default">移到分类:</div>';
  cats.forEach(c=>{h+='<div class="ctx-item" onclick="moveBoardToCat(\''+escAttr(c.name)+'\')">'+escHtml(c.name)+'</div>';});
  h+='<div class="ctx-sep"></div>';
  h+='<div class="ctx-item" onclick="closeCtx();addCurrentToIndexBar()">添加到指数导航栏</div>';
  h+='<div class="ctx-sep"></div>';
  h+='<div class="ctx-item" onclick="closeCtx()">取消</div>';
  showCtxMenu(e.clientX,e.clientY,h);
}
function moveBoardToCat(catName){
  if(!_ctxBoard)return;
  const cats=store.categoryData;
  let srcCat=null,srcIdx=-1;
  for(const c of cats){
    const i=c.boards.findIndex(b=>b.code===_ctxBoard.code&&b.type===_ctxBoard.type);
    if(i>=0){srcCat=c;srcIdx=i;break;}
  }
  if(!srcCat)return;
  const board=srcCat.boards.splice(srcIdx,1)[0];
  const dst=cats.find(c=>c.name===catName);
  if(dst)dst.boards.push(board);
  renderNav();closeCtx();toast('已移到「'+catName+'」');
  // 持久化到服务器
  _saveClassification();
}

async function _saveClassification(){
  try{
    await fetch(API+'/api/classification/save', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({categories:store.categoryData})
    });
  }catch(e){console.warn('分类保存失败',e);}
}
function showCtxMenu(x,y,h){const m=document.getElementById('ctx-menu');m.innerHTML=h;m.style.left=x+'px';m.style.top=y+'px';m.classList.add('show');}
function closeCtx(){document.getElementById('ctx-menu').classList.remove('show');_ctxBoard=null;}
document.addEventListener('click',e=>{if(!e.target.closest('#ctx-menu'))closeCtx();});
document.addEventListener('contextmenu',e=>{if(!e.target.closest('#nav-panel'))closeCtx();});

// ===== 3. KLineChart Pro Datafeed（带请求取消+超时控制） =====
class BoardDatafeed {
  constructor(){this._timer=null;this._activeReqs=new Map();this._seq=0;}
  async searchSymbols(search) {
    if(!store.categoryData) return [];
    const results = [];
    store.categoryData.forEach(cat => {
      cat.boards.forEach(b => {
        if (!search || b.name.includes(search) || b.code.includes(search)) {
          results.push({
            ticker: b.code, name: b.name, shortName: b.name,
            type: b.type, market: 'A', exchange: '中国', priceCurrency: 'CNY'
          });
        }
      });
    });
    return results;
  }
  async getHistoryKLineData(symbol, period, from, to) {
    const mySeq = ++this._seq;
    // 取消同symbol+period的旧请求
    const symKey = symbol.ticker+':'+period.timespan+':'+period.multiplier;
    if(this._activeReqs.has(symKey)){this._activeReqs.get(symKey).abort();}
    const ctrl = new AbortController();
    this._activeReqs.set(symKey, ctrl);
    function periodToApi(p) {
      const t=p.timespan, m=p.multiplier;
      if(t==='minute') return m+'m';
      if(t==='hour') return (m*60)+'m';
      if(t==='day') return 'daily';
      if(t==='week') return 'weekly';
      if(t==='month'){if(m===1)return 'monthly';if(m===3)return 'quarterly';if(m===12)return 'yearly';return 'monthly';}
      return 'daily';
    }
    const p = periodToApi(period);
    const tid = setTimeout(()=>ctrl.abort(), 15000);
    try {
      const r = await fetch(API+'/api/kline/'+(symbol.type||'industry')+'/'+symbol.ticker
        +'?name='+encodeURIComponent(symbol.name||symbol.shortName)+'&period='+p+'&timeout=15', {signal:ctrl.signal});
      clearTimeout(tid);
      this._activeReqs.delete(symKey);
      if(this._seq!==mySeq) return [];  // 已有更新的请求，丢弃当前结果
      const j = await r.json();
      if(j.loading) return [];
      if(j.error){console.warn('kline data error:',j.error);return [];}
      return (j.data||[]).map(d=>({timestamp:d.timestamp,open:d.open,high:d.high,low:d.low,close:d.close,volume:d.volume||0}));
    } catch(e) {
      clearTimeout(tid);
      this._activeReqs.delete(symKey);
      if(e.name==='AbortError'){console.warn('kline fetch timeout for',symbol.ticker);return [];}
      throw e;
    }
  }
  subscribe(symbol, period, callback) {
    clearInterval(this._timer);
    this._timer = setInterval(async () => {
      try {
        const ctrl = new AbortController();
        const t = setTimeout(()=>ctrl.abort(), 10000);
        const r = await fetch(API+'/api/spot/'+(symbol.type||'industry')+'/'+symbol.ticker,{signal:ctrl.signal});
        clearTimeout(t);
        if(!r.ok) return;
        const j = await r.json();
        const data = j.data && j.data.price ? j.data : null;
        if(data) {
          const now = Date.now();
          callback({timestamp:now,close:data.price,open:data.open||data.price,high:data.high||data.price,low:data.low||data.price,volume:data.volume||0});
        }
      } catch(e) { if(e.name!=='AbortError') console.warn('spot poll err:',e); }
    }, 30000);
  }
  unsubscribe(symbol, period) { clearInterval(this._timer); }
}
const _datafeed = new BoardDatafeed();

// ===== 4. 初始化 KLineChart Pro（带CDN重试机制） =====
let _pendingSymbol = null; // 等待pro初始化后应用的symbol
let _initProAttempts = 0;
const MAX_INIT_ATTEMPTS = 20; // 最多重试20次（约10秒）

function initPro() {
  const container = document.getElementById('pro-container');
  if (!container) return false;
  
  // CDN未加载 → 显示等待UI并自动重试
  if (!window.klinechartspro) {
    _initProAttempts++;
    if (_initProAttempts >= MAX_INIT_ATTEMPTS) {
      // 最终失败：显示错误UI + 重试按钮
      container.innerHTML = '<div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;color:#ef5350;font-size:13px">'+
        '<div style="font-size:28px;margin-bottom:12px">📊</div>'+
        '<div>KLineChart Pro 加载失败</div>'+
        '<div style="font-size:11px;color:#787b86;margin:8px 0">CDN资源可能被网络代理拦截</div>'+
        '<button onclick="forceReloadPro()" style="padding:6px 16px;border:1px solid #ef5350;border-radius:4px;background:transparent;color:#ef5350;cursor:pointer;font-size:12px">重新加载</button>'+
        '</div>';
      console.error('[Pro] CDN加载失败，已重试', MAX_INIT_ATTEMPTS, '次');
      return false;
    }
    // 显示等待状态
    if (_initProAttempts <= 3) {
      container.innerHTML = '<div class="placeholder" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);color:#434651;font-size:14px;text-align:center">'+
        '<div style="font-size:24px;margin-bottom:8px">⏳</div>'+
        '正在加载KLineChart Pro...<br><span style="font-size:10px">('+_initProAttempts+'/'+MAX_INIT_ATTEMPTS+')</span>'+
        '</div>';
    }
    // 500ms后重试
    setTimeout(initPro, 500);
    return false;
  }
  
  // CDN已加载 → 初始化
  try {
    // 移除 placeholder
    const ph = container.querySelector('.placeholder');
    if (ph) ph.remove();
    
    pro = new window.klinechartspro.KLineChartPro({
      container: container,
      theme: 'dark',
      locale: 'zh-CN',
      drawingBarVisible: true,
      watermark: null, // 去除水印
      // 蜡烛图：红涨绿跌（中国习惯）
      styles: {
        candle: {
          bar: {
            upColor: '#ef5350', upBorderColor: '#ef5350', upWickColor: '#ef5350',
            downColor: '#26a69a', downBorderColor: '#26a69a', downWickColor: '#26a69a'
          }
        },
        // 等间距K线，避免周末/节假日断点
        timeAxis: { type: 'bar' },
        // 成交量颜色跟随K线：红涨绿跌
        indicator: {
          bars: [{ upColor: 'rgba(239,83,80,0.7)', downColor: 'rgba(38,166,154,0.7)' }]
        }
      },
      // 默认加载上证指数
      symbol: { ticker: 'sh000001', name: '上证指数', shortName: '上证指数', type: 'index', market: 'A', priceCurrency: 'CNY' },
      period: { multiplier: 1, timespan: 'day', text: '日' },
      periods: [
        { multiplier: 1, timespan: 'minute', text: '1m' },
        { multiplier: 5, timespan: 'minute', text: '5m' },
        { multiplier: 15, timespan: 'minute', text: '15m' },
        { multiplier: 1, timespan: 'hour', text: '1H' },
        { multiplier: 2, timespan: 'hour', text: '2H' },
        { multiplier: 4, timespan: 'hour', text: '4H' },
        { multiplier: 1, timespan: 'day', text: '日' },
        { multiplier: 1, timespan: 'week', text: '周' },
        { multiplier: 1, timespan: 'month', text: '月' },
        { multiplier: 3, timespan: 'month', text: '季' },
        { multiplier: 12, timespan: 'month', text: '年' },
      ],
      timezone: 'Asia/Shanghai',
      mainIndicators: ['MA'],
      subIndicators: ['VOL'],
      datafeed: _datafeed
    });
    toast('KLineChart Pro 就绪');
    _initProAttempts = 0;
    
    // 应用等待中的symbol
    if (_pendingSymbol) {
      setTimeout(() => {
        if (pro && pro.setSymbol) {
          pro.setSymbol(_pendingSymbol);
          loadSignals(_pendingSymbol.ticker);
        }
        _pendingSymbol = null;
      }, 100);
    }
    return true;
  } catch(e) {
    console.error('Pro init error:', e);
    toast('Pro 初始化失败: '+e.message);
    return false;
  }
}

// 强制重新加载Pro（用户点击重试按钮）
function forceReloadPro() {
  _initProAttempts = 0;
  // 尝试重新注入CDN脚本
  if (!window.klinechartspro) {
    injectCDNScripts();
  }
  setTimeout(initPro, 300);
}

// CDN脚本注入（带fallback）
function injectCDNScripts() {
  const cdnBase = 'https://cdn.jsdelivr.net/npm';
  const altCdnBase = 'https://unpkg.com';
  
  function loadScript(src) {
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = src;
      s.onload = resolve;
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }
  
  // 尝试主CDN，失败则用备用
  loadScript(`${cdnBase}/klinecharts@9.6.0/dist/klinecharts.min.js`)
    .then(() => loadScript(`${cdnBase}/@klinecharts/pro/dist/klinecharts-pro.umd.js`))
    .catch(() => {
      console.warn('[CDN] 主CDN失败，尝试备用');
      return loadScript(`${altCdnBase}/klinecharts@9.6.0/dist/klinecharts.min.js`)
        .then(() => loadScript(`${altCdnBase}/@klinecharts/pro/dist/klinecharts-pro.umd.js`));
    })
    .then(() => { console.log('[CDN] 脚本加载成功'); })
    .catch((e) => { console.error('[CDN] 所有CDN失败:', e); });
}

// ===== 5. 板块选择 -> 交给 Pro（带防卡死保护+预加载+请求状态管理） =====

// 页面加载后预加载第一个板块
function preloadFirstBoard(){
  const first = document.querySelector('.board-item');
  if(first){
    const name = first.dataset.name;
    const code = first.dataset.code;
    const type = first.dataset.type;
    if(!_preloadDone[code+type]){
      _preloadDone[code+type] = true;
      fetch(API+'/api/kline/'+type+'/'+code+'?name='+encodeURIComponent(name)+'&period=daily&timeout=15').catch(()=>{});
    }
  }
}
setTimeout(preloadFirstBoard, 500);

// 初始化：加载分析历史
loadAnalysisHistory();
renderAnalysisHistory();
// 初始化：检测WorkBuddy Hook
detectWorkBuddyHook();

function selectBoard(name,code,type,ev){
  // 点击去重：200ms内重复点击忽略
  if(_lastClickBoard && _lastClickBoard.code===code && _lastClickBoard.type===type
     && Date.now()-_lastClickTime < 200) return;
  _lastClickTime = Date.now();
  const reqId = ++_currentRequestId;

  if(ev) document.querySelectorAll('.board-item.active').forEach(e=>e.classList.remove('active'));
  if(ev && ev.target.closest('.board-item')) ev.target.closest('.board-item').classList.add('active');
  store.selected={name,code,type};
  _lastClickBoard={name,code,type};
  
  showLoading();

  const symbol = { ticker: code, name: name, shortName: name, type: type, market: 'A', priceCurrency: 'CNY' };
  const seq = ++_pendingSym;
  if (_datafeed && _datafeed.unsubscribe) _datafeed.unsubscribe();
  
  if (pro && pro.setSymbol) {
    pro.setSymbol(symbol);
    hideLoading();
  } else {
    // pro未就绪 → 存入pending，等initPro完成后应用
    _pendingSymbol = symbol;
    console.warn('pro not ready, queued symbol:', symbol.ticker);
  }
  
  loadSignals(code);
}

// 二级导航栏：悬浮显示成分股
const _consPanel = document.getElementById('floating-cons');
let _consPanelTimer = null;

function showConsPanel(name, code, type, ev){
  clearTimeout(_consPanelTimer);
  
  // 从board-item取定位
  const item = ev.target.closest('.board-item');
  if(!item) return;
  
  // 构建浮动面板内容
  const boardType = type === 'industry' ? 'industry' : 'concept';
  
  // 显示加载状态
  _consPanel.innerHTML = '<div class="fcons-header">'+escHtml(name)+' 成分股 <span style="float:right">加载中...</span></div>';
  
  // 定位到item右侧
  const rect = item.getBoundingClientRect();
  _consPanel.style.left = '280px';  // 导航栏宽度
  _consPanel.style.top = Math.max(36, rect.top) + 'px';
  _consPanel.style.display = 'block';
  _consPanel.classList.add('show');
  
  // 获取数据
  fetch(API+'/api/board-cons-sorted/'+boardType+'/'+code)
    .then(r=>r.json())
    .then(resp=>{
      const items = resp.data || [];
      let h = '<div class="fcons-header">'+escHtml(name)+' 成分股 <span style="float:right">'+items.length+'只</span></div>';
      if(!items.length){
        h += '<div class="fcons-item" style="color:#434651;cursor:default">无数据</div>';
      } else {
        items.forEach(function(s){
          const capStr = s.mkt_cap >= 10000 ? (s.mkt_cap/10000).toFixed(2)+'万亿' : s.mkt_cap.toFixed(0)+'亿';
          const chg = s.change_pct || 0;
          const chgCls = chg > 0 ? 'up' : (chg < 0 ? 'down' : '');
          const chgStr = (chg > 0 ? '+' : '') + chg.toFixed(2) + '%';
          h += '<div class="fcons-item" onclick="closeConsPanel();selectBoard(\''+escAttr(s.name)+'\',\''+s.code+'\',\'stock\',null)">'+
            '<span class="fcons-code">'+s.code+'</span>'+
            '<span class="fcons-name">'+escHtml(s.name)+'</span>'+
            '<span class="fcons-pct '+chgCls+'">'+chgStr+'</span>'+
            '<span class="fcons-cap">'+capStr+'</span></div>';
        });
      }
      _consPanel.innerHTML = h;
    })
    .catch(function(){_consPanel.innerHTML = '<div class="fcons-header">加载失败</div>';});
}

function closeConsPanel(){
  _consPanel.classList.remove('show');
  _consPanel.style.display = 'none';
}

// 点击面板外部关闭
document.addEventListener('click', function(e){
  if(!e.target.closest('#floating-cons') && !e.target.closest('.board-item')){
    closeConsPanel();
  }
});

// 板块涨幅排序切换
function toggleBoardSort(){
  store._sortBoardByChg = !store._sortBoardByChg;
  renderNav();
  if(store._sortBoardByChg) loadBoardChanges();
}

// 加载所有板块涨跌幅
let _boardChgData = null;
async function loadBoardChanges(){
  try{
    const r = await fetch(API+'/api/board-changes');
    const resp = await r.json();
    _boardChgData = resp.data || {};
    // 填充到所有board-item上
    document.querySelectorAll('.board-item').forEach(function(el){
      const code = el.dataset.code;
      const type = el.dataset.type;
      const key = type + ':' + code;
      const chg = _boardChgData[key];
      const span = el.querySelector('.board-chg');
      if(span && chg !== undefined){
        const cls = chg > 0 ? 'up' : (chg < 0 ? 'down' : '');
        span.className = 'board-chg ' + cls;
        span.textContent = (chg > 0 ? '+' : '') + chg.toFixed(2) + '%';
        el.dataset.chg = chg;
      }
    });
    // 如果启用了涨幅排序，重新排序
    if(store._sortBoardByChg) sortBoardItemsByChg();
  } catch(e){}
}

function sortBoardItemsByChg(){
  document.querySelectorAll('.collapsed').forEach(function(col){
    const items = Array.from(col.querySelectorAll('.board-item'));
    items.sort(function(a,b){
      return (parseFloat(b.dataset.chg) || 0) - (parseFloat(a.dataset.chg) || 0);
    });
    items.forEach(function(el){ col.appendChild(el); });
  });
}

// 初始化加载涨跌幅
setTimeout(loadBoardChanges, 1500);

// 加载提示动画
function showLoading(){
  const plc = document.querySelector('#pro-container .placeholder');
  if(plc) plc.innerHTML = '加载中...';
}
function hideLoading(){
  const plc = document.querySelector('#pro-container .placeholder');
  if(plc && plc.parentElement.querySelector('.klinecharts-pro')) plc.remove();
}

