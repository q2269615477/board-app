"""
data_update_manager.py - 数据更新管理器（v4.0）
统一管理 板块 + 指数 + 个股 的定时更新 / 按需更新
集成 rate_limiter 防限流：滑动窗口 + 指数退避 + 健康检查
策略：每天定时更新，更新前检查今日是否已更新，保证面板数据新鲜
"""
import json
import time
import threading
import logging
import random
from pathlib import Path
from datetime import datetime, timedelta
import pandas as pd
import akshare as ak

from rate_limiter import (
    akshare_limiter, akshare_queue, akshare_retry,
    is_akshare_rate_limited, BatchProgress
)

# 日志配置
log_path = Path('data') / 'update_logs'
log_path.mkdir(parents=True, exist_ok=True)
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s [%(levelname)s] %(message)s',
    handlers=[
        logging.FileHandler(log_path / f'update_{datetime.now().strftime("%Y%m%d")}.log', encoding='utf-8'),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger('data_update')

STATUS_FILE = Path('data') / 'update_status.json'
_update_lock = threading.Lock()
_update_in_progress = False


def _load_status() -> dict:
    if STATUS_FILE.exists():
        try:
            with open(STATUS_FILE, 'r', encoding='utf-8') as f:
                data = json.load(f)
                # 确保嵌套结构存在
                if 'indices' not in data: data['indices'] = {}
                if 'boards' not in data: data['boards'] = {}
                if 'stocks' not in data: data['stocks'] = {}
                return data
        except Exception:
            pass
    return {
        'boards': {},
        'indices': {},
        'stocks': {},
        'today': '',  # 记录当天已完成更新的日期字符串
        'scheduler': {'last_run': '', 'next_run': '', 'status': 'idle'}
    }


def _save_status(status: dict):
    with _update_lock:
        try:
            with open(STATUS_FILE, 'w', encoding='utf-8') as f:
                json.dump(status, f, ensure_ascii=False, indent=2)
        except Exception as e:
            logger.error(f"保存状态失败: {e}")


def _mark_today_done():
    """标记今天已完成全量更新"""
    status = _load_status()
    status['today'] = datetime.now().strftime('%Y-%m-%d')
    _save_status(status)
    logger.info(f"[标记] 今日({status['today']})全量更新已完成")


def is_today_updated() -> bool:
    """检查今天是否已完成全量更新"""
    status = _load_status()
    return status.get('today') == datetime.now().strftime('%Y-%m-%d')




# ===== 个股台账（SQLite存储） =====

import sqlite3 as _sqlite3
_LEDGER_DB = str(Path('data') / 'kline.db')

def _get_ledger_conn():
    conn = _sqlite3.connect(_LEDGER_DB)
    conn.row_factory = _sqlite3.Row
    return conn

def is_stock_cached(code: str) -> bool:
    conn = _get_ledger_conn()
    cur = conn.execute('SELECT 1 FROM stock_ledger WHERE code=?', (code,))
    r = cur.fetchone() is not None
    conn.close()
    return r

def add_stock_to_ledger(code: str, name: str = ''):
    conn = _get_ledger_conn()
    conn.execute(
        "INSERT OR REPLACE INTO stock_ledger (code, name, first_cached, last_updated) "
        "VALUES (?, ?, COALESCE((SELECT first_cached FROM stock_ledger WHERE code=?), "
        "datetime('now','localtime')), datetime('now','localtime'))",
        (code, name, code))
    conn.commit()
    conn.close()
    logger.info(f"[台账] 已记录个股 {code}({name})")

def get_all_cached_stocks() -> list:
    conn = _get_ledger_conn()
    cur = conn.execute('SELECT code FROM stock_ledger ORDER BY code')
    rows = [r[0] for r in cur.fetchall()]
    conn.close()
    return rows


# ===== 个股数据（按需更新） =====

def update_stock_if_needed(code: str, force: bool = False, name: str = '') -> bool:
    """按需更新个股（日/周/月线全部缓存），同时记录台账"""
    from data_loader import load_stock_kline, load_stock_data
    try:
        # 1. 更新日线
        df = load_stock_data(code)
        # 2. 更新周线/月线（按需，仅当用户查看过才会触发）
        load_stock_kline(code, 'weekly')
        load_stock_kline(code, 'monthly')
        # 3. 记录台账
        add_stock_to_ledger(code, name)
        # 4. 更新状态
        status = _load_status()
        status['stocks'][code] = {'last_update': datetime.now().strftime('%Y-%m-%d %H:%M:%S'), 'rows': len(df)}
        _save_status(status)
        return True
    except Exception as e:
        logger.error(f"[个股] {code} 更新失败: {e}")
        return False




# ===== 已缓存个股的每日增量更新 =====

def update_all_cached_stocks(max_retries: int = 2) -> dict:
    """每日增量更新所有已缓存个股的日/周/月线"""
    codes = get_all_cached_stocks()
    if not codes:
        logger.info("[个股日更] 台账为空，无个股需更新")
        return {'success': 0, 'failed': 0, 'total': 0}

    result = {'success': 0, 'failed': 0, 'total': len(codes)}
    logger.info(f"[个股日更] 开始更新 {len(codes)} 只已缓存个股")

    for code in codes:
        for attempt in range(max_retries):
            try:
                from data_loader import load_stock_data, load_stock_kline
                load_stock_data(code)       # 日线增量
                load_stock_kline(code, 'weekly')   # 周线
                load_stock_kline(code, 'monthly')  # 月线
                # 更新时间戳
                ledger = _load_ledger()
                if code in ledger:
                    ledger[code]['last_updated'] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
                _save_ledger(ledger)
                result['success'] += 1
                break
            except Exception as e:
                if attempt < max_retries - 1:
                    time.sleep(3)
                else:
                    result['failed'] += 1
                    logger.warning(f"[个股日更] {code} 更新失败: {e}")

    logger.info(f"[个股日更] 完成: 成功{result['success']}, 失败{result['failed']}")
    return result


# ===== 板块周月线刷新（日线更新后，重算周月线CSV） =====

def _refresh_board_weekly_monthly(board_type: str, name: str, code: str, period: str) -> bool:
    """刷新单个板块的周/月线缓存"""
    from data_loader import load_board_kline
    try:
        load_board_kline(board_type, name, code, period)
        return True
    except Exception:
        return False


def refresh_all_boards_weekly_monthly() -> dict:
    """日线更新后，刷新所有板块的周线和月线CSV"""
    import json as _json
    cf = Path('static') / 'board_classification.json'
    if not cf.exists():
        return {'success': 0, 'failed': 0, 'total': 0}
    try:
        with open(cf, 'r', encoding='utf-8') as f:
            cats = _json.load(f).get('categories', [])
    except Exception:
        return {'success': 0, 'failed': 0, 'total': 0}

    boards = [(b['type'], b['name'], b['code']) for cat in cats for b in cat.get('boards', [])]
    result = {'success': 0, 'failed': 0, 'total': len(boards) * 2}  # 周+月

    for btype, name, code in boards:
        for period in ('weekly', 'monthly'):
            ok = _refresh_board_weekly_monthly(btype, name, code, period)
            if ok:
                result['success'] += 1
            else:
                result['failed'] += 1

    logger.info(f"[周月线刷新] 完成: 成功{result['success']}, 失败{result['failed']}")
    return result


# ===== 指数数据（定时更新+按需更新） =====

# 顶部工具栏的11个指数
INDEX_LIST = [
    ('HSI', '恒生指数', 'hk_index'),
    ('HSTECH', '恒生科技', 'hk_index'),
    ('BK1158', '微盘股', 'concept'),
    ('800000', '东方财富全A', 'index'),
]


def _update_single_index(code: str, name: str, data_type: str) -> bool:
    """更新单个指数数据到CSV"""
    from data_loader import load_index_kline, load_hk_index_kline, load_board_kline
    try:
        logger.info(f"[指数] 更新 {name}({code})")
        if data_type == 'hk_index':
            load_hk_index_kline(code)
        elif data_type == 'concept':
            load_board_kline('concept', name, code)
        else:
            load_index_kline(code)
        status = _load_status()
        status['indices'][code] = {
            'last_update': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'status': 'success', 'name': name
        }
        _save_status(status)
        logger.info(f"[指数] {name}({code}) 更新成功")
        return True
    except Exception as e:
        error_msg = str(e)[:200]
        status = _load_status()
        status['indices'][code] = {
            'last_update': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
            'status': 'failed', 'error': error_msg, 'name': name
        }
        _save_status(status)
        logger.error(f"[指数] {name}({code}) 更新失败: {error_msg}")
        return False


def update_all_indices(max_retries: int = 3) -> dict:
    """全量更新所有顶部指数（每日定时+启动时调用）"""
    result = {'success': 0, 'failed': 0, 'total': len(INDEX_LIST)}
    logger.info(f"[指数] 开始更新 ({result['total']}个)")

    for code, name, dtype in INDEX_LIST:
        for attempt in range(max_retries):
            ok = _update_single_index(code, name, dtype)
            if ok:
                result['success'] += 1
                break
            elif attempt < max_retries - 1:
                wait = (attempt + 1) * 5
                logger.info(f"[指数] {name} 第{attempt+1}次失败，{wait}秒后重试")
                time.sleep(wait)
            else:
                result['failed'] += 1

    logger.info(f"[指数] 更新完成: 成功{result['success']}, 失败{result['failed']}")
    return result


# ===== 板块数据（定时自动更新） =====

def _update_single_board(board_type: str, name: str, code: str) -> bool:
    from data_loader import DATA_ROOT
    subdir = DATA_ROOT / ('行业板块K线数据' if board_type == 'industry' else '概念板块K线数据')
    subdir.mkdir(parents=True, exist_ok=True)
    csv_path = subdir / f'{name}_{code}.csv'

    try:
        logger.info(f"[板块] 更新 {name}({code})")
        if board_type == 'industry':
            raw = ak.stock_board_industry_hist_em(
                symbol=name, period='日k',
                start_date='20000101', end_date='20991231'
            )
        else:
            raw = ak.stock_board_concept_hist_em(
                symbol=name, period='daily',
                start_date='20000101', end_date='20991231'
            )

        if raw is not None and not raw.empty:
            if csv_path.exists():
                try:
                    local = pd.read_csv(csv_path, encoding='utf-8-sig')
                    merged = pd.concat([local, raw], ignore_index=True)
                    merged = merged.drop_duplicates(subset=['日期'], keep='last')
                    merged = merged.sort_values('日期').reset_index(drop=True)
                    merged.to_csv(csv_path, index=False, encoding='utf-8-sig')
                except Exception:
                    raw.to_csv(csv_path, index=False, encoding='utf-8-sig')
            else:
                raw.to_csv(csv_path, index=False, encoding='utf-8-sig')

            status = _load_status()
            status['boards'][code] = {'last_update': datetime.now().strftime('%Y-%m-%d %H:%M:%S'), 'status': 'success'}
            _save_status(status)
            logger.info(f"[板块] {name}({code}) 更新成功")
            return True
        else:
            logger.warning(f"[板块] {name}({code}) 返回空数据")
            return False
    except Exception as e:
        error_msg = str(e)[:200]
        status = _load_status()
        status['boards'][code] = {'last_update': datetime.now().strftime('%Y-%m-%d %H:%M:%S'), 'status': 'failed', 'error': error_msg}
        _save_status(status)
        logger.error(f"[板块] {name}({code}) 更新失败: {error_msg}")
        return False


def update_all_boards(max_retries: int = 3) -> dict:
    global _update_in_progress
    if _update_in_progress:
        logger.warning("[板块] 上次更新尚未完成，跳过")
        return {'success': 0, 'failed': 0, 'total': 0, 'error': '上次更新进行中'}

    _update_in_progress = True
    result = {'success': 0, 'failed': 0, 'total': 0}

    try:
        import json as _json
        cf = Path('static') / 'board_classification.json'
        if not cf.exists():
            raise FileNotFoundError("board_classification.json 不存在")
        with open(cf, 'r', encoding='utf-8') as f:
            cats = _json.load(f).get('categories', [])
        boards = [(b['type'], b['name'], b['code']) for cat in cats for b in cat.get('boards', [])]
        result['total'] = len(boards)
        logger.info(f"[板块] 共 {len(boards)} 个")

        # 使用带限流的批量进度控制器
        progress = BatchProgress(len(boards), name='板块更新')
        for idx, (btype, name, code) in enumerate(boards):
            # 限流等待：每个请求间隔 2-5 秒
            akshare_limiter.wait_and_acquire()
            time.sleep(random.uniform(1.5, 4.0))

            ok, _, _ = akshare_retry.execute(
                _update_single_board, btype, name, code,
                context=f"{name}({code})",
                is_rate_limited=is_akshare_rate_limited,
            )
            if ok:
                result['success'] += 1
            else:
                result['failed'] += 1
            progress.tick(ok)

        logger.info(f"[板块] 完成: 成功{result['success']}, 失败{result['failed']}, 共{result['total']}")
    except Exception as e:
        logger.error(f"[板块] 异常: {e}")
    finally:
        _update_in_progress = False

    _update_scheduler_status()
    return result


# ===== 统一日更入口（指数+板块一次完成） =====

def update_all_today(max_retries: int = 3) -> dict:
    """
    每日全量更新入口：先查当天是否已更新，未更新则执行
    先检查AKShare是否可用，不可用则跳过板块更新
    """
    if is_today_updated():
        logger.info("[日更] 今天已更新，跳过")
        return {'skipped': True, 'message': '今日已更新'}

    logger.info("=" * 50)
    logger.info("[日更] === 开始每日全量更新 ===")
    result = {'indices': None, 'boards': None, 'stocks': None, 'weekly_monthly': None}

    # 0. 检查AKShare是否可用（快速探测）
    akshare_ok = False
    try:
        import requests as _req
        r = _req.get('https://push2.eastmoney.com/api/qt/stock/get',
                      params={'secid': '1.000001', 'fields': 'f57,f58,f43'},
                      timeout=3)
        akshare_ok = r.status_code == 200 and len(r.text) > 20
    except Exception:
        akshare_ok = False

    if not akshare_ok:
        logger.warning("[日更] ⚠️ 东财API不可用，跳过板块/周月线/个股更新（使用本地缓存数据）")
        result['akshare_blocked'] = True

    # 1. 更新指数（11个，速度快）
    result['indices'] = update_all_indices(max_retries)

    # 2. 板块更新（仅当AKShare可用时）
    if akshare_ok:
        result['boards'] = update_all_boards(max_retries)
        result['weekly_monthly'] = refresh_all_boards_weekly_monthly()
        result['stocks'] = update_all_cached_stocks()
    else:
        result['boards'] = {'success': 0, 'failed': 0, 'total': 0, 'skipped': True}
        result['weekly_monthly'] = {'success': 0, 'failed': 0, 'total': 0, 'skipped': True}
        result['stocks'] = {'success': 0, 'failed': 0, 'total': 0, 'skipped': True}
        logger.info("[日更] 跳过板块/周月线/个股更新")

    # 3. 标记今日完成
    _mark_today_done()

    logger.info("[日更] === 每日全量更新完成 ===")
    logger.info("=" * 50)
    return result


def _update_scheduler_status():
    status = _load_status()
    status['scheduler']['last_run'] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    status['scheduler']['next_run'] = (datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')
    status['scheduler']['status'] = 'completed'
    _save_status(status)


# ===== 交易日历 =====

_trade_dates_cache = None
_trade_dates_cached_at = 0

def _is_trading_day() -> bool:
    """判断今天是否为A股交易日"""
    global _trade_dates_cache, _trade_dates_cached_at
    now = time.time()
    if _trade_dates_cache is not None and now - _trade_dates_cached_at < 3600:
        return _trade_dates_cache
    try:
        df = ak.tool_trade_date_hist_sina()
        # AKShare返回的trade_date是datetime.date，统一转字符串比较
        trade_dates = set(df['trade_date'].astype(str).values)
        today_str = datetime.now().strftime('%Y-%m-%d')
        is_trade = today_str in trade_dates
        _trade_dates_cache = is_trade
        _trade_dates_cached_at = now
        logger.info(f"[交易日] {today_str} {'是' if is_trade else '非'}交易日")
        return is_trade
    except Exception as e:
        logger.warning(f"[交易日] 查询失败({e})，默认是交易日")
        return True


def next_trade_close_time() -> datetime:
    """计算下次收盘更新时刻（交易日 15:30，非交易日跳过）"""
    now = datetime.now()
    today_close = now.replace(hour=15, minute=30, second=0, microsecond=0)
    if _is_trading_day():
        if now < today_close:
            return today_close  # 今天还没收盘，等收盘后更新
        else:
            if not is_today_updated():
                return now  # 立即更新
            return _next_trade_close()
    else:
        return _next_trade_close()


def _next_trade_close() -> datetime:
    """找到下一个交易日的收盘时间"""
    now = datetime.now()
    try:
        df = ak.tool_trade_date_hist_sina()
        trade_set = set(df['trade_date'].astype(str).values)
    except Exception:
        # 回退：每天18:00
        return now.replace(hour=18, minute=0) + timedelta(days=1)

    for offset in range(1, 15):  # 最多查15天
        candidate = now + timedelta(days=offset)
        candidate = candidate.replace(hour=15, minute=30, second=0, microsecond=0)
        if candidate.strftime('%Y-%m-%d') in trade_set:
            return candidate
    return now.replace(hour=18, minute=0) + timedelta(days=1)


# ===== 定时调度器（交易日历感知） =====

_scheduler_thread = None
_scheduler_running = False


def _scheduler_loop():
    global _scheduler_running
    logger.info("[调度器] 启动（交易日历感知）")
    _scheduler_running = True

    while _scheduler_running:
        try:
            now = datetime.now()
            is_trade = _is_trading_day()

            if not is_trade:
                next_trade = _next_trade_close()
                wait_sec = (next_trade - now).total_seconds()
                logger.info(f"[调度器] 非交易日，距下次更新 {(next_trade).strftime('%m-%d %H:%M')} 还有 {wait_sec/3600:.1f}小时")
            else:
                close_time = now.replace(hour=15, minute=30, second=0, microsecond=0)
                if now < close_time:
                    wait_sec = (close_time - now).total_seconds()
                    logger.info(f"[调度器] 交易中，收盘后更新（{wait_sec/3600:.1f}小时后）")
                elif is_today_updated():
                    next_trade = _next_trade_close()
                    wait_sec = (next_trade - now).total_seconds()
                    logger.info(f"[调度器] 今日已更新，下次 {(next_trade).strftime('%m-%d %H:%M')}")
                else:
                    logger.info("[调度器] 收盘后触发更新")
                    _notify_event('data_updating', '全量更新')
                    update_all_today()
                    # 收盘后同步 QMT 指数数据
                    try:
                        import qmt_bridge as _qb
                        if _qb.connect():
                            for code, name, qmt_code in [
                                ('sh000001','上证指数','000001.SH'), ('sz399006','创业板指','399006.SZ'),
                                ('sh000688','科创50','000688.SH'), ('sh000300','沪深300','000300.SH'),
                                ('sh000016','上证50','000016.SH'), ('sh000852','中证1000','000852.SH'),
                                ('sh000853','中证2000','000853.SH'), ('sh000985','中证全指','000985.SH'),
                                ('HSI','恒生指数','HSI.HK'), ('HSTECH','恒生科技','HSTECH.HK'),
                            ]:
                                try:
                                    _qb.download_latest(qmt_code)
                                    data = _qb.get_kline(qmt_code, start_date='20260625')
                                    if data:
                                        _qb.write_to_db(code, 'daily', data)
                                        logger.info(f"  ✓ {name}")
                                except Exception as e:
                                    logger.warning(f"  ✗ {name}: {e}")
                            # 不再调用 disconnect()，保持长连接
                    except Exception as e:
                        logger.warning(f"[QMT] 收盘同步失败: {e}")
                    _notify_event('data_updated', '全量完成')
                    wait_sec = 86400

            status = _load_status()
            next_dt = now + timedelta(seconds=wait_sec)
            status['scheduler']['next_run'] = next_dt.strftime('%Y-%m-%d %H:%M:%S')
            status['scheduler']['status'] = 'waiting'
            _save_status(status)

            remaining = wait_sec
            while remaining > 0 and _scheduler_running:
                time.sleep(min(60, remaining))
                remaining -= 60

        except Exception as e:
            logger.error(f"[调度器] 异常: {e}")
            time.sleep(60)


def start_scheduler():
    global _scheduler_thread
    if _scheduler_thread and _scheduler_thread.is_alive():
        return
    _scheduler_thread = threading.Thread(target=_scheduler_loop, daemon=True, name='data-scheduler')
    _scheduler_thread.start()
    logger.info("[调度器] 已启动")

    # 启动时检查：如果是交易日且已收盘，立即触发一次更新
    import threading as _t2
    def _startup_check():
        time.sleep(3)  # 等系统就绪
        now = datetime.now()
        if _is_trading_day() and now.hour >= 15 and not is_today_updated():
            logger.info("[调度器] 启动时检测到交易日已收盘，触发立即更新")
            _notify_event('data_updating', '启动后首次更新')
            update_all_today()
            _notify_event('data_updated', '首次更新完成')
    _t2.Thread(target=_startup_check, daemon=True).start()


def stop_scheduler():
    global _scheduler_running
    _scheduler_running = False
    logger.info("[调度器] 已停止")


# ===== SSE 事件通知 =====

_events = []
_events_lock = threading.Lock()

def _notify_event(event_type: str, message: str = ''):
    with _events_lock:
        _events.append({'type': event_type, 'message': message, 'time': datetime.now().strftime('%H:%M:%S')})
        if len(_events) > 20:
            _events[:] = _events[-20:]

def get_sse_events(last_index: int = 0):
    with _events_lock:
        if last_index >= len(_events):
            return [], len(_events)
        return _events[last_index:], len(_events)


# ===== 状态查询 =====

def get_update_status() -> dict:
    status = _load_status()
    boards = status.get('boards', {})
    indices = status.get('indices', {})
    stocks = status.get('stocks', {})

    idx_success = sum(1 for v in indices.values() if v.get('status') == 'success')
    idx_failed = sum(1 for v in indices.values() if v.get('status') == 'failed')
    board_success = sum(1 for v in boards.values() if v.get('status') == 'success')
    board_failed = sum(1 for v in boards.values() if v.get('status') == 'failed')

    return {
        'today_done': status.get('today'),
        'today_updated': is_today_updated(),
        'scheduler': status.get('scheduler', {}),
        'index_stats': {'total': len(indices), 'success': idx_success, 'failed': idx_failed},
        'board_stats': {'total': len(boards), 'success': board_success, 'failed': board_failed},
        'stock_count': len(stocks),
        'update_in_progress': _update_in_progress,
        'rate_limiter': {
            'remaining': akshare_limiter.remaining,
            'queue': akshare_queue.stats() if hasattr(akshare_queue, 'stats') else {},
        },
        'last_log_file': str(log_path / f'update_{datetime.now().strftime("%Y%m%d")}.log')
    }


# ===== 健康检查（执行前检测AKShare是否可用） =====

def health_check() -> dict:
    """执行全量更新前的健康检查"""
    import requests as _req
    try:
        r = _req.get('https://push2.eastmoney.com/api/qt/stock/get',
                      params={'secid': '1.000001', 'fields': 'f57,f58,f43'},
                      timeout=5)
        api_ok = r.status_code == 200 and len(r.text) > 20
    except Exception:
        api_ok = False
    return {
        'akshare_available': api_ok,
        'rate_limiter_remaining': akshare_limiter.remaining,
        'recommendation': '可以执行' if api_ok else '⚠️ 东财API不可用，建议等待后再试',
    }
