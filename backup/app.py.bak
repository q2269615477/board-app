# --- SSE 事件推送（数据更新后通知前端刷新） ---

import time as _sse_time

@app.route('/api/events')
def sse_event_stream():
    """SSE endpoint：推送数据更新 + AI分析事件给前端"""
    def event_stream():
        last_idx = 0
        while True:
            # 数据更新事件
            events, last_idx = get_sse_events(last_idx)
            for ev in events:
                yield f"event: {ev['type']}\ndata: {ev['message']}\n\n"
            # AI事件（存储在模块变量中，由_notify_event写入_ai_sse_queue）
            while _ai_sse_event_queue:
                ai_ev = _ai_sse_event_queue.pop(0)
                yield f"event: {ai_ev['type']}\ndata: {ai_ev['data']}\n\n"
            _sse_time.sleep(1)  # AI事件用1秒间隔更快响应
    from flask import Response
    return Response(
        event_stream(),
        mimetype='text/event-stream',
        headers={
            'Cache-Control': 'no-cache',
            'Connection': 'keep-alive',
            'X-Accel-Buffering': 'no',
        }
    )

def _notify_event(typ, msg):
    """推送事件到SSE系统（内部事件+前端AI队列）"""
    # 内部事件
    try:
        log_file = BASE_DIR / 'data' / 'sse_events.log'
        with open(log_file, 'a', encoding='utf-8') as f:
            f.write(json.dumps({'type': typ, 'message': msg, 'time': datetime.now().strftime('%H:%M:%S')}, ensure_ascii=False) + '\n')
    except:
        pass
    # AI事件入队（供SSE推送）
    if typ in ('ai_analyzing', 'ai_result', 'signals_updated', 'data_updated'):
        try:
            with _ai_sse_event_lock:
                _ai_sse_event_queue.append({'type': typ, 'data': msg})
        except:
            pass


