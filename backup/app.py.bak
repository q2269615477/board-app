@app.route('/api/signals/<board_code>', methods=['POST'])
def post_signals(board_code):
    """提交板块信号"""
    data = request.get_json()
    skill = data.get('skill')
    new_signals = data.get('signals', [])
    replace = data.get('replace', False)
    if not skill or not new_signals:
        return jsonify({'error': 'missing skill or signals'}), 400
    append_signals(board_code, skill, new_signals, replace)
    return jsonify({'ok': True, 'count': len(new_signals), 'mode': 'replace' if replace else 'append'})

