def _get_cached_kline(key):
    return g_cache.get(key)
def _get_kline_meta(key):
    return _kline_meta.get(key, {})
def _set_cached_kline(key, data, last_date=''):
    g_cache.set(key, data)
    if last_date:
        _kline_meta[key] = {'last_date': last_date, 'cached_at': __import__('datetime').datetime.now().strftime('%H:%M:%S')}
def _pop_pending(key):
    v = _KLINE_PENDING.pop(key, None)
    if isinstance(v, _tlk.Event):
        v.set()  # 通知其他等待线程


# SQLite快速读取 + 后台AKShare刷新（防卡死）
def _db_read_kline_safe(code, period, board_name=''):
    """从SQLite快速读取板块数据"""
    import sqlite3
    conn = sqlite3.connect('data/kline.db')
    try:
        cur = conn.execute(
            'SELECT date, open, high, low, close, volume FROM kline WHERE code=? AND period=? ORDER BY date',
            (code, period))
        rows = cur.fetchall()
        if rows:
            import pandas as pd
            return pd.DataFrame(rows, columns=['date','open','high','low','close','volume'])
    finally:
        conn.close()
    # SQLite无数据，回退load_board_kline
    from data_loader import load_board_kline as _lbk
    return _lbk('industry' if board_name else 'concept', board_name, code, period)


def _bg_board_refresh(data_type, board_name, code, period, cache_key):
    """后台线程：尝试AKShare更新（超时3秒），成功后刷新缓存+推SSE"""
    import time as _bt
    _bt.sleep(0.5)  # 先让主响应返回
    btype = 'industry' if data_type == 'industry' else 'concept'
    from data_loader import load_board_kline as _lbk
    try:
        df = _lbk(btype, board_name, code, period)
        if df is not None and not df.empty:
            from cache_manager import g_cache as _gc
            data = _format_kline(df)
            last_date = df['date'].max() if not df.empty else ''
            _gc.set(cache_key, data)
            d = df['date'].max() if not df.empty else ''
            print(f"[后台刷新] {board_name}({code}) 完成, 末日期={d}")
            # 如果当前正在显示这个板块，通知前端刷新
            _notify_event('data_updated', f'{code}')
    except Exception as e:
        pass  # 静默失败，已有SQLite数据

def _format_kline(df, from_ms=0, to_ms=0):
    """格式化K线数据（from/to 参数保留但不使用，前端一次性加载全部）"""
    return [{
        'timestamp': int(pd.Timestamp(r['date']).timestamp() * 1000),
        'open': float(r['open']), 'high': float(r['high']),
        'low': float(r['low']), 'close': float(r['close']),
        'volume': float(r['volume'])
    } for _, r in df.iterrows()]


# ---- QMT 多周期数据加载 ----
import pandas as _pd

def _qmt_code(code: str, data_type: str) -> str:
    """面板代码 → QMT 代码"""
    idx_map = {
        'sh000001': '000001.SH', 'sz399006': '399006.SZ',
        'sh000688': '000688.SH', 'sh000300': '000300.SH',
        'sh000016': '000016.SH', 'sh000852': '000852.SH',
        'sh000853': '000853.SH', 'sh000985': '000985.SH',
        'HSI': 'HSI.HK', 'HSTECH': 'HSTECH.HK',
    }
    if code in idx_map:
        return idx_map[code]
    # 通用指数微代码映射：sh000510 → 000510.SH, sz399001 → 399001.SZ
    if code.startswith('sh') and code[2:].isdigit() and len(code) == 8:
        return f'{code[2:]}.SH'
    if code.startswith('sz') and code[2:].isdigit() and len(code) == 8:
        return f'{code[2:]}.SZ'
    if code.startswith('bj') and code[2:].isdigit() and len(code) == 8:
        return f'{code[2:]}.BJ'
    if data_type == 'stock' and len(code) == 6:
        return f'{code}.SH' if code.startswith(('6','9')) else f'{code}.SZ'
    if data_type in ('hk', 'hk_index') and len(code) <= 5:
        return f'{code}.HK'
    return code

def _load_qmt_kline(code: str, data_type: str, period: str):
    """QMT subprocess(58610) - 支持日线和分钟线K线"""
    qmt_code = _qmt_code(code, data_type)
    minute_map = {'1m':'1m','5m':'5m','15m':'15m','30m':'30m','60m':'60m','120m':'120m','240m':'240m'}
    today = _pd.Timestamp.now().strftime('%Y%m%d')
    if period == 'daily':
        qmt_period = '1d'; start = '20200101'; date_fmt = '%Y-%m-%d'
    elif period in minute_map:
        qmt_period = minute_map[period]
        start = (_pd.Timestamp.now() - _pd.Timedelta(days=7)).strftime('%Y%m%d')
        date_fmt = '%Y-%m-%d %H:%M'
    else:
        return _pd.DataFrame()
    import subprocess as _sp, tempfile as _tf, os as _os
    qmt_py = r'D:\迅投极速策略交易系统交易终端 大同证券QMT实盘\bin.x64\python.exe'
    qmt_dir = r'D:\迅投极速策略交易系统交易终端 大同证券QMT实盘\bin.x64'
    script_path = _os.path.join(_tf.gettempdir(), f'_qk_{code}_{period}.py')
    script_content = (
        "from xtquant import xtdata\n"
        "import json,sys,os\n"
        f"os.chdir(r'{qmt_dir}')\n"
        "for port in ['58600','58610']:\n"
        "    try: xtdata.rpc_init('127.0.0.1:'+port); break\n"
        "    except: pass\n"
        f"c=sys.argv[1]; p='{qmt_period}'; s='{start}'; e='{today}'\n"
        "is_min = p != '1d'\n"
        "xtdata.download_history_data(c,p,s,e)\n"
        "raw=xtdata.get_local_data(['time','open','high','low','close','volume'],[c],p,s,e,count=-1)\n"
        "if isinstance(raw,dict) and c in raw and raw[c] is not None and not raw[c].empty:\n"
        "    df=raw[c]; r=[]\n"
        "    for idx,row in df.iterrows():\n"
        "        idx_int=int(idx) if isinstance(idx,(int,float)) else 0\n"
        "        if is_min and idx_int>1e13:\n"
        "            si=str(idx_int)\n"
        "            dt=f'{si[:4]}-{si[4:6]}-{si[6:8]} {si[8:10]}:{si[10:12]}'\n"
        "        elif idx_int>1e12:\n"
        "            from pandas import to_datetime\n"
        "            dt=str(to_datetime(idx_int,unit='ms').date())\n"
        "        else:\n"
        "            dt=str(idx)\n"
        "        vol=int(float(row['volume']))\n"
        "        if vol==0: continue\n"
        "        r.append({'date':dt,'open':round(float(row['open']),2),'high':round(float(row['high']),2),'low':round(float(row['low']),2),'close':round(float(row['close']),2),'volume':vol})\n"
        "    print(json.dumps(r,ensure_ascii=False))\n"
        "else:\n"
        "    print('[]')\n"
    )
    with open(script_path, 'w', encoding='utf-8') as f:
        f.write(script_content)
    proc = _sp.run([qmt_py, script_path, qmt_code], capture_output=True, timeout=30, cwd=qmt_dir)
    out_str = proc.stdout.decode('utf-8', errors='ignore').strip()
    if not out_str:
        out_str = '[]'
    import json as _js
    data = _js.loads(out_str)
    if data:
        print(f"[QMT] {code}({qmt_code}) {period}: {len(data)}条")
        return _pd.DataFrame(data)
    return _pd.DataFrame()


def _load_qmt_daily(code: str, data_type: str) -> _pd.DataFrame:
    """通过 QMT 获取日线数据并缓存到 SQLite"""
    qmt_code = _qmt_code(code, data_type)
    try:
        from xtquant import xtdata as _xt
        import sqlite3 as _sql
        from pathlib import Path as _P
        _xt.download_history_data(qmt_code, period='1d',
            start_time='20200101', end_time=_pd.Timestamp.now().strftime('%Y%m%d'))
        raw = _xt.get_local_data(
            field_list=['time','open','high','low','close','volume'],
            stock_list=[qmt_code], period='1d',
            start_time='20200101', end_time=_pd.Timestamp.now().strftime('%Y%m%d'), count=0)
        if isinstance(raw, dict) and qmt_code in raw:
            qdf = raw[qmt_code]
            if qdf is not None and not qdf.empty:
                records = []
                for _, r in qdf.iterrows():
                    ts = r.get('time', 0)
                    ds = _pd.to_datetime(ts, unit='ms').strftime('%Y-%m-%d') if isinstance(ts, (int, float)) and ts > 1e12 else str(ts)[:10]
                    records.append({
                        'date': ds,
                        'open': float(r.get('open',0)), 'high': float(r.get('high',0)),
                        'low': float(r.get('low',0)), 'close': float(r.get('close',0)),
                        'volume': float(r.get('volume',0))
                    })
                df = _pd.DataFrame(records)
                if not df.empty:
                    conn = _sql.connect(str(_P('data')/'kline.db'))
                    for _, r in df.iterrows():
                        conn.execute(
                            'INSERT OR REPLACE INTO kline (code,period,date,open,high,low,close,volume) '
                            'VALUES (?,?,?,?,?,?,?,?)',
                            (code, 'daily', r['date'], r['open'], r['high'], r['low'], r['close'], r['volume']))
                    conn.commit(); conn.close()
                    print(f"[QMT] 已缓存 {code} 日线 {len(df)}条到SQLite")
                return df
    except Exception as e:
        print(f"[QMT] {code} 日线加载失败: {e}")
    return _pd.DataFrame()


def _load_kline_with_resample(data_type: str, code: str, period: str, board_name: str = '') -> _pd.DataFrame:
    """从日线重采样获取月/季/年线"""
    try:
        from data_loader import load_stock_kline, load_index_kline, load_hk_index_kline, _resample
        import sqlite3 as _sql
        from pathlib import Path as _P
        # 加载日线
        if data_type in ('industry', 'concept'):
            df = _db_read_kline_safe(code, 'daily', board_name)
        elif data_type == 'stock':
            df = load_stock_kline(code, 'daily')
            if df.empty and QMT_AVAILABLE:
                df = _load_qmt_daily(code, data_type)
        elif data_type == 'index':
            df = load_index_kline(code, 'daily')
            if df.empty and QMT_AVAILABLE:
                df = _load_qmt_daily(code, data_type)
        elif data_type == 'hk_index':
            df = load_hk_index_kline(code, 'daily')
            if df.empty and QMT_AVAILABLE:
                df = _load_qmt_daily(code, data_type)
        else:
            df = _pd.DataFrame()
        if not df.empty:
            return _resample(df, period)
        return df
    except Exception as e:
        print(f"[重采样] {code} {period} 失败: {e}")
        return _pd.DataFrame()


def _qmt_background_sync(code: str, data_type: str, _: str = ''):
    """后台异步从 QMT 更新个股/指数日线数据到 SQLite（已废弃，现用主动下载）"""
    pass


def _load_from_loader(data_type, code, period, board_name=''):
    """从现有 loader 读取（SQLite → 空则 QMT 回退）"""
    df = _pd.DataFrame()
    if data_type in ('industry', 'concept'):
        df = _db_read_kline_safe(code, period, board_name)
    elif data_type == 'stock':
        df = load_stock_kline(code, period)
        if df.empty and QMT_AVAILABLE:
            df = _load_qmt_kline(code, data_type, period)
    elif data_type == 'index':
        df = load_index_kline(code, period)
        if df.empty and QMT_AVAILABLE:
            df = _load_qmt_kline(code, data_type, period)
    elif data_type == 'hk':
        df = load_hk_kline(code, period)
    elif data_type == 'hk_index':
        df = load_hk_index_kline(code, period)
        if df.empty and QMT_AVAILABLE:
            df = _load_qmt_kline(code, 'hk_index', period)
    elif data_type == 'us':
        df = _db_read_kline(code, period)
        if df.empty:
            try:
                import concurrent.futures
                with concurrent.futures.ThreadPoolExecutor(max_workers=1) as _ex:
                    future = _ex.submit(_fetch_us_index, code)
                    df = future.result(timeout=5)
            except:
                pass
        return df


def _write_to_sqlite(code: str, df: _pd.DataFrame):
    """将 QMT 拉取的数据写入 SQLite"""
    if df.empty:
        return
    try:
        import sqlite3 as _sql
        from pathlib import Path as _P
        conn = _sql.connect(str(_P('data') / 'kline.db'))
        for _, r in df.iterrows():
            conn.execute(
                'INSERT OR REPLACE INTO kline (code,period,date,open,high,low,close,volume) '
                'VALUES (?,?,?,?,?,?,?,?)',
                (code, 'daily', r['date'], r['open'], r['high'], r['low'], r['close'], r['volume']))
        conn.commit()
        conn.close()
        print(f"[QMT→SQLite] {code}: {len(df)}条, 最新{r['date']}")
    except Exception as e:
        print(f"[QMT→SQLite] {code} 写入失败: {e}")


def _clear_kline_cache(data_type: str, code: str):
    """清除 g_cache 中的日线缓存"""
    g_cache.delete(f'{data_type}:{code}:daily')
    _kline_meta.pop(f'{data_type}:{code}:daily', None)


def _load_kline_data(data_type, code, period, board_name):
    """在线程池中执行的实际数据加载逻辑"""
    try:
        minute_periods = {'1m', '5m', '15m', '30m', '60m', '120m', '240m'}
        # 分钟级（指数+个股都走QMT）
        if period in minute_periods and QMT_AVAILABLE:
            df = _load_qmt_kline(code, data_type, period)
            if df.empty and data_type in ('index', 'stock', 'hk_index'):
                df = _load_qmt_kline(code, 'hk_index', period)
            return df
        elif data_type in ('stock', 'index', 'hk_index') and QMT_AVAILABLE and period == 'daily':
            df = _load_qmt_kline(code, data_type, period)
            if not df.empty:
                _write_to_sqlite(code, df)
                _clear_kline_cache(data_type, code)
            else:
                df = _load_from_loader(data_type, code, period, board_name)
        elif data_type == 'us':
            df = _load_from_loader(data_type, code, period, board_name)
        elif period in ('weekly', 'monthly', 'quarterly', 'yearly') and data_type == 'stock':
            df = _load_kline_with_resample(data_type, code, period, board_name)
        elif period in ('quarterly', 'yearly'):
            df = _load_kline_with_resample(data_type, code, period, board_name)
        elif data_type in ('industry', 'concept'):
            df = _load_from_loader(data_type, code, period, board_name)
        else:
            df = _load_from_loader(data_type, code, period, board_name)
            if df.empty and QMT_AVAILABLE:
                df = _load_qmt_kline(code, 'hk_index', period)
        return df
    except Exception as e:
        print(f"[KLine] 后台加载失败 {data_type}:{code}: {e}")
        return None

@app.route('/api/kline/<data_type>/<code>')
def get_kline(data_type, code):
    """统一的K线数据接口（异步化 + 超时控制 + 缓存优先）"""
    t_start = __import__('time').time()
    board_name = request.args.get('name', '')
    period = request.args.get('period', 'daily')
    force = request.args.get('force', '').lower() == 'true'
    timeout = float(request.args.get('timeout', '15'))  # 默认15秒超时
    cache_key = f'{data_type}:{code}:{period}'

    # 强制刷新
    if force:
        g_cache.delete(cache_key)
        _kline_meta.pop(cache_key, None)

    # 缓存命中 → 立即返回
    cached = _get_cached_kline(cache_key)
    if cached is not None:
        meta = _get_kline_meta(cache_key)
        elapsed = (__import__('time').time() - t_start) * 1000
        print(f"[耗时] {data_type}:{code} 缓存命中 {elapsed:.0f}ms ({len(cached)}条)")
        return jsonify({'data': cached, 'count': len(cached), 'cached': True,
                        'last_date': meta.get('last_date',''), 'cached_at': meta.get('cached_at','')})

    # 正在加载中 → 等待
    if cache_key in _KLINE_PENDING:
        # 等待已有任务完成（最多等10秒）
        evt = _KLINE_PENDING[cache_key]
        if isinstance(evt, _tlk.Event):
            evt.wait(min(timeout, 10))
            # 再次检查缓存
            cached = _get_cached_kline(cache_key)
            if cached is not None:
                meta = _get_kline_meta(cache_key)
                return jsonify({'data': cached, 'count': len(cached), 'cached': True,
                                'last_date': meta.get('last_date','')})
            # 超时仍未完成，返回loading状态让前端重试
            return jsonify({'loading': True, 'message': '数据加载中，请稍后重试'}), 202

    # 提交到线程池异步加载
    evt = _tlk.Event()
    _KLINE_PENDING[cache_key] = evt

    future = _kline_executor.submit(_load_kline_data, data_type, code, period, board_name)

    try:
        df = future.result(timeout=timeout)
        if df is None:
            raise Exception("加载超时或失败")
        data = _format_kline(df)
        last_date = df['date'].max() if not df.empty else ''
        _set_cached_kline(cache_key, data, last_date)
        elapsed = (__import__('time').time() - t_start) * 1000
        print(f"[耗时] {data_type}:{code} {period} 加载完成 {elapsed:.0f}ms ({len(data)}条)")
        _pop_pending(cache_key)
        return jsonify({'data': data, 'count': len(data), 'last_date': last_date,
                        'today': datetime.now().strftime('%Y-%m-%d'),
                        'range': f'{data[0]["timestamp"]}~{data[-1]["timestamp"]}' if data else ''})
    except Exception as e:
        _pop_pending(cache_key)
        elapsed = (__import__('time').time() - t_start) * 1000
        is_timeout = 'timeout' in str(e).lower() or 'TimeoutError' in type(e).__name__
        print(f"[耗时] {data_type}:{code} {'超时' if is_timeout else '异常'} {elapsed:.0f}ms: {e}")
        return jsonify({'error': str(e), 'timeout': is_timeout, 'data': [], 'count': 0}), 408 if is_timeout else 500



