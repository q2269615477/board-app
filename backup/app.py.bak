@app.route('/api/update/force', methods=['POST'])
def trigger_force_update():
    """强制刷新所有数据：清缓存+全量更新"""
    import threading as _tfu
    def _run():
        from data_update_manager import update_all_today
        import json as _jfu
        g_cache.clear()
        logger = __import__('logging').getLogger('data_update')
        logger.info("[强制更新] 清空缓存，开始全量刷新")
        _notify_event('data_updating', '强制全量更新')
        
        # 重置今日标记，迫使调度器重新拉取
        from pathlib import Path as _Pfu
        sf = _Pfu('data') / 'update_status.json'
        if sf.exists():
            with open(sf, 'r', encoding='utf-8') as _ffu:
                st = _jfu.load(_ffu)
            st['today'] = ''
            with open(sf, 'w', encoding='utf-8') as _ffu:
                _jfu.dump(st, _ffu, ensure_ascii=False, indent=2)
        
        result = update_all_today()
        _notify_event('data_updated', '强制更新完成')
        logger.info(f"[强制更新] 完成: {result}")
    _tfu.Thread(target=_run, daemon=True).start()
    return jsonify({'ok': True, 'message': '全量强制更新已触发'})


