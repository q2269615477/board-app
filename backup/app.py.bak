# ====== 增强搜索 API（个股+指数+板块，拼音匹配，搜索历史） ======

_SEARCH_INDEX = None  # 内存缓存
_SEARCH_INDEX_MTIME = 0

def _load_search_index() -> dict:
    """加载搜索索引（带文件修改时间缓存）"""
    global _SEARCH_INDEX, _SEARCH_INDEX_MTIME
    idx_file = BASE_DIR / 'static' / 'search_index.json'
    if not idx_file.exists():
        print("[搜索] 索引文件不存在，尝试构建...")
        try:
            from build_search_index import build_index_json
            build_index_json()
        except Exception as e:
            print(f"[搜索] 构建索引失败: {e}")
            return {}
    mtime = idx_file.stat().st_mtime
    if _SEARCH_INDEX is None or mtime > _SEARCH_INDEX_MTIME:
        with open(idx_file, 'r', encoding='utf-8') as f:
            data = json.load(f)
        _SEARCH_INDEX = data.get('items', {})
        _SEARCH_INDEX_MTIME = mtime
        print(f"[搜索] 索引已加载: {len(_SEARCH_INDEX)} 条")
    return _SEARCH_INDEX


@app.route('/api/search')
def api_search():
    """
    全市场搜索 API
    ?q=PFYH   → 拼音首字母匹配
    ?q=浦发    → 名称包含匹配
    ?q=600000 → 代码匹配
    返回排序后的结果列表
    """
    q = request.args.get('q', '').strip()
    if not q:
        return jsonify({'data': []})

    idx = _load_search_index()
    if not idx:
        return jsonify({'data': [], 'error': '索引未加载'})

    q_upper = q.upper()

    # 判断是否纯 ASCII 字母数字（拼音或代码搜索）
    is_ascii = bool(q_upper and all(ord(c) < 128 and (c.isalnum() or c in '-.') for c in q_upper))
    is_pinyin = is_ascii and bool(q_upper and all(c.isalpha() or c.isdigit() for c in q_upper))

    results = []
    # 搜索历史优先（由前端传参，后端不维护）
    priority_codes = set()
    priority_str = request.args.get('history', '')
    if priority_str:
        for c in priority_str.split(','):
            priority_codes.add(c.strip())

    for code, info in idx.items():
        name = info.get('name', '')
        initials = info.get('initials', [])
        initials_str = ''.join(initials).upper()
        code_upper = code.upper()

        score = 0  # 匹配度分数

        # 拼音首字母前缀匹配（仅对纯ASCII输入）
        if is_pinyin and initials and len(q_upper) <= len(initials):
            match = True
            for i, ch in enumerate(q_upper):
                if i >= len(initials) or not initials[i] or not initials[i].upper().startswith(ch):
                    match = False
                    break
            if match:
                score = 100 + len(initials) - len(q_upper)  # 前缀匹配优先

        # 名称包含匹配（对中文/英文输入都有效）
        if q_upper in name.upper():
            # 名字越短、匹配位置越靠前，分数越高
            pos = name.upper().index(q_upper)
            score = max(score, 80 - pos * 2 - len(name) * 0.5)

        # 完整拼音首字母匹配（允许中间跳过）
        if is_pinyin and initials_str and q_upper in initials_str:
            score = max(score, 60)

        # 代码精确匹配（最高优先级）
        if code_upper == q_upper:
            score = 200
        elif code_upper.startswith(q_upper):
            score = max(score, 70)
        elif q_upper in code_upper:
            score = max(score, 30)

        if score > 0:
            # 搜索历史置顶
            if code in priority_codes:
                score += 1000
            # 生成显示用代码
            display_code = code
            if code.startswith('sh') and len(code) == 8:
                display_code = code[2:] + '.SH'
            elif code.startswith('sz') and len(code) == 8:
                display_code = code[2:] + '.SZ'
            elif code.startswith('bj') and len(code) == 8:
                display_code = code[2:] + '.BJ'
            results.append({
                'code': code,
                'display_code': display_code,
                'name': name,
                'type': info.get('type', ''),
                'category': info.get('category', ''),
                'initials': ''.join(initials),
                'score': score,
            })

    # 按分数降序排序，取前20
    results.sort(key=lambda x: -x['score'])
    return jsonify({'data': results[:20]})


@app.route('/api/search/history', methods=['POST'])
def api_search_history():
    """记录搜索历史（服务端持久化，备用）"""
    data = request.get_json() or {}
    code = data.get('code', '')
    name = data.get('name', '')
    if not code:
        return jsonify({'ok': False})
    try:
        hist_file = BASE_DIR / 'data' / 'search_history.json'
        if hist_file.exists():
            with open(hist_file, 'r') as f:
                hist = json.load(f)
        else:
            hist = []
        # 去重，最新在前面
        hist = [h for h in hist if h.get('code') != code]
        hist.insert(0, {'code': code, 'name': name, 'time': datetime.now().strftime('%Y-%m-%d %H:%M:%S')})
        hist = hist[:50]  # 保留最多50条
        with open(hist_file, 'w', encoding='utf-8') as f:
            json.dump(hist, f, ensure_ascii=False, indent=1)
        return jsonify({'ok': True})
    except Exception as e:
        return jsonify({'ok': False, 'error': str(e)})


@app.route('/api/search/history', methods=['GET'])
def api_get_search_history():
    """获取搜索历史"""
    try:
        hist_file = BASE_DIR / 'data' / 'search_history.json'
        if hist_file.exists():
            with open(hist_file, 'r') as f:
                hist = json.load(f)
            return jsonify({'data': hist})
        return jsonify({'data': []})
    except Exception as e:
        return jsonify({'data': [], 'error': str(e)})


@app.route('/api/board-cons/<board_type>/<code>')
def get_board_constituents(board_type, code):
    """从本地缓存的成分股JSON返回板块成分股"""
    import os as _os
    fname = f'data/{board_type}_constituents.json'
    full = _os.path.join(_os.path.dirname(__file__), fname)
    if not _os.path.exists(full):
        return jsonify({'error': f'文件不存在:{full}'}), 404
    try:
        with open(full, 'r', encoding='utf-8') as f:
            data = json.load(f)
        key = f'{board_type}:{code}'
        if key in data:
            return jsonify({'data': data[key]['cons'], 'count': data[key]['n']})
    except Exception as e:
        return jsonify({'error': str(e)}), 500
    return jsonify({'data': [], 'count': 0})


_MARKET_CAP_CACHE = {}

def _get_market_cap(code: str) -> float:
    """从QMT计算总市值（缓存1小时）市值=昨收×总股本"""
    import time as _t
    now = _t.time()
    if code in _MARKET_CAP_CACHE and now - _MARKET_CAP_CACHE[code].get('t', 0) < 3600:
        return _MARKET_CAP_CACHE[code]['v']
    try:
        from xtquant import xtdata as _xt
        _xt.connect(port=58610); _xt.enable_hello = False
        suffix = '.SH' if code.startswith('6') else '.SZ'
        d = _xt.get_instrument_detail(code + suffix)
        if not d:
            suffix = '.SZ' if suffix == '.SH' else '.SH'
            d = _xt.get_instrument_detail(code + suffix)
        if d:
            v = (d.get('PreClose', 0) or 0) * (d.get('TotalVolume', 0) or 0)
            _MARKET_CAP_CACHE[code] = {'v': v, 't': now}
            return v
    except: pass
    return 0


@app.route('/api/board-cons-sorted/<board_type>/<code>')
def get_board_constituents_sorted(board_type, code):
    """带市值排序的板块成分股"""
    import os as _os, time as _t
    fname = f'data/{board_type}_constituents.json'
    full = _os.path.join(_os.path.dirname(__file__), fname)
    if not _os.path.exists(full):
        return jsonify({'error': 'not found'}), 404
    with open(full, 'r', encoding='utf-8') as f:
        data = json.load(f)
    key = f'{board_type}:{code}'
    if key not in data:
        return jsonify({'data': [], 'count': 0})
    
    cons = data[key]['cons'][:]
    # 批量获取市值
    for c in cons:
        _get_market_cap(c['code'])
    # 排序
    cons.sort(key=lambda x: _MARKET_CAP_CACHE.get(x['code'], {}).get('v', 0), reverse=True)
    # 附上市值
    for c in cons:
        cap = _MARKET_CAP_CACHE.get(c['code'], {}).get('v', 0)
        c['mkt_cap'] = round(cap / 1e8, 1) if cap else 0
        c['change_pct'] = _get_stock_change(c['code'])
    return jsonify({'data': cons, 'count': len(cons)})


_STOCK_CHG_CACHE = {}

def _get_stock_change(code: str) -> float:
    """获取个股今日涨跌幅"""
    import time as _t
    now = _t.time()
    if code in _STOCK_CHG_CACHE and now - _STOCK_CHG_CACHE[code].get('t', 0) < 300:
        return _STOCK_CHG_CACHE[code]['v']
    try:
        from xtquant import xtdata as _xt
        _xt.connect(port=58610); _xt.enable_hello = False
        suffix = '.SH' if code.startswith('6') else '.SZ'
        d = _xt.get_instrument_detail(code + suffix)
        if not d:
            suffix = '.SZ' if suffix == '.SH' else '.SH'
            d = _xt.get_instrument_detail(code + suffix)
        if d and d.get('PreClose', 0):
            # 获取今日最新价
            qmt_code = code + suffix
            _xt.download_history_data(qmt_code, '1d', '20260701', '20260702')
            ld = _xt.get_local_data(['close'], [qmt_code], '1d', '20260701', '20260702', count=1)
            if qmt_code in ld and ld[qmt_code] is not None and not ld[qmt_code].empty:
                latest = float(ld[qmt_code].iloc[0]['close'])
                pre = d['PreClose']
                chg = round((latest / pre - 1) * 100, 2)
                _STOCK_CHG_CACHE[code] = {'v': chg, 't': now}
                return chg
    except: pass
    return 0


