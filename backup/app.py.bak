# ============================================================
# MCP 工具实现
# ============================================================

@app.route('/mcp/tools', methods=['GET'])
def mcp_list_tools():
    """列出所有可用MCP工具"""
    return jsonify({"tools": MCP_TOOLS})

@app.route('/mcp/call', methods=['POST'])
def mcp_call_tool():
    """统一MCP工具调用入口"""
    data = request.get_json() or {}
    tool = data.get('tool', '')
    args = data.get('arguments', {})
    handlers = {
        'get_kline': _handle_mcp_get_kline,
        'get_kline_snapshot': _handle_mcp_get_kline_snapshot,
        'get_signals': _handle_mcp_get_signals,
        'search': _handle_mcp_search,
        'submit_signals': _handle_mcp_submit_signals,
        'get_constituents': _handle_mcp_get_constituents,
        'list_boards': _handle_mcp_list_boards,
        'trigger_ai_analysis': _handle_mcp_trigger_ai,
        'submit_ai_result': _handle_mcp_submit_ai_result,
        'analyze_board': _handle_mcp_analyze_board,
    }
    handler = handlers.get(tool)
    if not handler:
        return jsonify({"error": f"Unknown tool: {tool}"}), 400
    try:
        return handler(args)
    except Exception as e:
        return jsonify({"error": str(e)}), 500

# ---- MCP 工具实现函数 ----

def _handle_mcp_get_kline(args):
    """获取完整K线数据"""
    code = args['code']
    dtype = args.get('type', 'industry')
    period = args.get('period', 'daily')
    name = args.get('name', '')
    start = args.get('start_date', '')
    end = args.get('end_date', '')
    cache_key = f'{dtype}:{code}:{period}'
    cached = _get_cached_kline(cache_key)
    if cached is not None:
        return jsonify({'data': cached, 'count': len(cached), 'cached': True})
    df = _load_from_loader(dtype, code, period, name)
    if start:
        df = df[df['date'] >= start]
    if end:
        df = df[df['date'] <= end]
    data = _format_kline(df)
    return jsonify({'data': data, 'count': len(data)})

def _handle_mcp_get_kline_snapshot(args):
    """获取K线快照（快速返回最近N条，优先缓存）"""
    code = args['code']
    dtype = args.get('type', 'industry')
    period = args.get('period', 'daily')
    name = args.get('name', '')
    count = args.get('count', 200)
    cache_key = f'{dtype}:{code}:{period}'
    cached = _get_cached_kline(cache_key)
    if cached is not None:
        data = cached[-count:] if len(cached) > count else cached
        return jsonify({'data': data, 'count': len(data), 'code': code, 'type': dtype, 'cached': True})
    df = _load_from_loader(dtype, code, period, name)
    if df is not None and not df.empty:
        data = _format_kline(df)
        data = data[-count:] if len(data) > count else data
        return jsonify({'data': data, 'count': len(data), 'code': code, 'type': dtype})
    return jsonify({'data': [], 'count': 0, 'code': code, 'type': dtype})

def _handle_mcp_search(args):
    """搜索股票/板块/指数"""
    q = args['query']
    idx = _load_search_index()
    results = []
    q_upper = q.upper()
    for code, info in idx.items():
        name = info.get('name', '')
        initials = info.get('initials', [])
        initials_str = ''.join(initials).upper()
        if (q_upper in name.upper() or q_upper in code.upper() or
            q_upper in initials_str or initials_str.startswith(q_upper)):
            results.append({
                'code': code, 'name': name, 'type': info.get('type',''),
                'category': info.get('category','')
            })
        if len(results) >= 20:
            break
    return jsonify({'data': results, 'count': len(results)})

def _handle_mcp_submit_signals(args):
    """提交信号"""
    board_code = args['board_code']
    skill = args['skill']
    signals = args.get('signals', [])
    replace = args.get('replace', False)
    append_signals(board_code, skill, signals, replace)
    # 信号更新后推SSE
    _notify_event('signals_updated', json.dumps({'board_code': board_code, 'skill': skill, 'count': len(signals)}))
    return jsonify({'ok': True, 'count': len(signals)})

def _handle_mcp_get_signals(args):
    """获取指定板块的历史信号"""
    board_code = args['board_code']
    skill = args.get('skill')
    limit = args.get('limit', 20)
    signals = load_signals().get(board_code, {})
    if skill:
        result = signals.get(skill, [])[-limit:]
    else:
        result = []
        for sk, sigs in signals.items():
            result.extend([{**s, 'skill': sk} for s in sigs])
        result = sorted(result, key=lambda x: x.get('date', ''), reverse=True)[:limit]
    return jsonify({"board_code": board_code, "signals": result, "count": len(result)})

def _handle_mcp_get_constituents(args):
    """获取成分股"""
    board_code = args['board_code']
    board_name = args.get('board_name', '')
    sort_by = args.get('sort_by', 'change_pct')
    for dtype in ['industry', 'concept']:
        fname = f'data/{dtype}_constituents.json'
        if os.path.exists(fname):
            with open(fname, 'r', encoding='utf-8') as f:
                cdata = json.load(f)
            key = f'{dtype}:{board_code}'
            if key in cdata:
                cons = cdata[key]['cons']
                return jsonify({'data': cons, 'count': len(cons), 'board_type': dtype})
    return jsonify({'data': [], 'count': 0})

def _handle_mcp_list_boards(args):
    """列出所有板块"""
    btype = args.get('type', 'all')
    keyword = args.get('keyword', '')
    result = []
    with open('static/board_classification.json', 'r', encoding='utf-8') as f:
        cdata = json.load(f)
    for cat in cdata:
        for b in cat.get('boards', []):
            bt = b.get('type', '')
            if btype != 'all' and bt != btype:
                continue
            if keyword and keyword.lower() not in b.get('name','').lower():
                continue
            result.append(b)
        if len(result) >= 200:
            break
    return jsonify({'data': result[:200], 'count': len(result[:200])})

def _handle_mcp_trigger_ai(args):
    """触发AI分析（前端技能按钮点击后调用）"""
    board_code = args['board_code']
    board_name = args['board_name']
    board_type = args.get('board_type', 'concept')
    skill_id = args.get('skill_id', '')
    skill_name = args.get('skill_name', skill_id)
    prompt_template = args.get('prompt_template', '')
    callback_id = str(uuid.uuid4())[:8]
    
    # 获取K线数据快照用于AI上下文
    cache_key = f'{board_type}:{board_code}:daily'
    kline_data = _get_cached_kline(cache_key)
    if kline_data is None:
        df = _load_from_loader(board_type, board_code, 'daily', board_name)
        if df is not None and not df.empty:
            kline_data = _format_kline(df[-200:])
    
    # 构建AI分析prompt
    prompt = prompt_template.replace('{name}', board_name).replace('{code}', board_code)
    if kline_data:
        last = kline_data[-1] if kline_data else {}
        prompt += f"\n\n--- 最新K线数据 ---\n"
        prompt += f"日期: {last.get('timestamp', '')}\n"
        prompt += f"开盘: {last.get('open', '')} 最高: {last.get('high', '')} 最低: {last.get('low', '')} 收盘: {last.get('close', '')} 成交量: {last.get('volume', '')}\n"
        prompt += f"\n共 {len(kline_data)} 条K线数据"
    
    # 创建等待事件
    evt = _tlk.Event()
    with _ai_result_lock:
        _ai_trigger_events[f'{board_code}:{skill_id}'] = evt
    
    # 推SSE通知前端"AI正在分析"
    _notify_event('ai_analyzing', json.dumps({
        'board_code': board_code, 'board_name': board_name,
        'skill_id': skill_id, 'skill_name': skill_name, 'callback_id': callback_id
    }))
    
    return jsonify({
        'callback_id': callback_id,
        'prompt': prompt,
        'kline_count': len(kline_data) if kline_data else 0,
        'status': 'analyzing'
    })

def _handle_mcp_analyze_board(args):
    """板块分析（占位，实际分析由AI技能触发）"""
    return jsonify({'ok': True, 'note': '请使用 trigger_ai_analysis + submit_ai_result 两步流'})

def _handle_mcp_submit_ai_result(args):
    """提交AI分析结论（由 WorkBuddy Hook 调用）"""
    return _submit_ai_result_internal(args)

def _submit_ai_result_internal(args):
    """内部：存储AI分析结论 + 推送SSE"""
    board_code = args.get('board_code', '')
    skill_id = args.get('skill_id', '')
    result = {
        'callback_id': args.get('callback_id', ''),
        'board_code': board_code,
        'board_name': args.get('board_name', ''),
        'skill_id': skill_id,
        'summary': args.get('summary', ''),
        'direction': args.get('direction', 'neutral'),
        'confidence': args.get('confidence', 0.5),
        'annotations': args.get('annotations', []),
        'key_levels': args.get('key_levels', {'support': [], 'resistance': []}),
        'operation': args.get('operation', {}),
        'risk_warning': args.get('risk_warning', ''),
        'timestamp': _dt.now().strftime('%Y-%m-%d %H:%M:%S')
    }
    # 持久化信号到本地
    if result['annotations']:
        append_signals(board_code, skill_id, result['annotations'])
    
    with _ai_result_lock:
        _ai_result_store[board_code] = result
        # 解除等待事件
        trigger_key = f'{board_code}:{skill_id}'
        if trigger_key in _ai_trigger_events:
            _ai_trigger_events[trigger_key].set()
            del _ai_trigger_events[trigger_key]
    
    # 推SSE事件给前端
    _notify_event('ai_result', json.dumps(result, ensure_ascii=False))
    
    return jsonify({'ok': True, 'board_code': board_code, 'stored': True})

# ============================================================
# REST API：AI 分析结果（供前端轮询 + WorkBuddy Hook 推送）
# ============================================================

@app.route('/api/ai/result', methods=['POST'])
def api_ai_result_post():
    """POST /api/ai/result — WorkBuddy Hook 推送AI分析结论"""
    data = request.get_json() or {}
    if not data.get('board_code') or not data.get('summary'):
        return jsonify({'error': 'missing board_code or summary'}), 400
    return _submit_ai_result_internal(data)

@app.route('/api/ai/result/<board_code>', methods=['GET'])
def api_ai_result_get(board_code):
    """GET /api/ai/result/<board_code> — 前端获取AI分析结论"""
    with _ai_result_lock:
        result = _ai_result_store.get(board_code)
    if result:
        return jsonify(result)
    return jsonify({'board_code': board_code, 'status': 'no_data'})

@app.route('/api/ai/result/<board_code>/clear', methods=['POST'])
def api_ai_result_clear(board_code):
    """清除指定板块的AI分析结论"""
    with _ai_result_lock:
        _ai_result_store.pop(board_code, None)
    return jsonify({'ok': True})

@app.route('/api/health', methods=['GET'])
def api_health():
    """健康检查（WorkBuddy Hook 检测用）"""
    return jsonify({'ok': True, 'service': 'board-app', 'ts': _dt.now().strftime('%Y-%m-%d %H:%M:%S')})

@app.route('/api/hooks/status', methods=['GET'])
def api_hooks_status():
    """返回当前面板的Hook配置"""
    return jsonify({
        'panel_url': 'http://127.0.0.1:5000',
        'hook_result_url': 'http://127.0.0.1:5000/api/ai/result',
        'panel_status': 'running',
        'instructions': '在 ~/.codebuddy/settings.json 中配置 PostToolUse Hook，target 设为 http://127.0.0.1:5000'
    })

# ============================================================
# WorkBuddy Hook 接收端点（供 WorkBuddy 配置回调）
# ============================================================

@app.route('/api/ai/hooks/post-tool-use', methods=['POST'])
def hook_post_tool_use():
    """接收 WorkBuddy PostToolUse 事件（工具调用后触发）"""
    data = request.get_json() or {}
    # 仅处理AI分析技能的完成事件
    # WorkBuddy 传来的消息可能是分析结论
    content = str(data.get('content', '') or data.get('result', ''))
    if not content:
        return jsonify({'ok': False, 'reason': 'no content'}), 200
    
    # 尝试解析JSON格式的分析结论
    try:
        result = json.loads(content) if content.startswith('{') else None
        if result and result.get('board_code') and result.get('summary'):
            return _submit_ai_result_internal(result)
    except (json.JSONDecodeError, TypeError):
        pass
    
    return jsonify({'ok': False, 'reason': 'not analysis result'}), 200


@app.route('/api/ai/hooks/stop', methods=['POST'])
def hook_stop():
    """WorkBuddy Stop 事件回调"""
    data = request.get_json() or {}
    return jsonify({'ok': True, 'received': True})


@app.route('/api/ai/hooks/subagent-stop', methods=['POST'])
def hook_subagent_stop():
    """WorkBuddy SubagentStop 事件回调"""
    data = request.get_json() or {}
    return jsonify({'ok': True, 'received': True})

@app.route('/mcp/resource', methods=['GET'])
def mcp_read_resource():
    uri = request.args.get('uri', '')
    match = re.match(r'^board://([^/]+)/(\w+)$', uri)
    if not match:
        return jsonify({"error": f"invalid uri: {uri}"}), 400
    code = match.group(1)
    signals = load_signals()
    return jsonify(signals.get(code, {}))

