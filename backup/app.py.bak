# ============================================================
# 后台线程池 — 用于K线数据异步加载和缓存预热
# ============================================================
from concurrent.futures import ThreadPoolExecutor, Future
import threading as _tlk

_kline_executor = ThreadPoolExecutor(max_workers=6, thread_name_prefix='kline_loader')
_board_chg_cache = {}      # 板块涨跌幅缓存
_board_chg_lock = _tlk.Lock()
_bg_refresh_tasks = {}      # 正在刷新的任务（去重）
_bg_refresh_lock = _tlk.Lock()

def _get_board_changes_cached():
    """获取缓存的板块涨跌幅（后台每60秒更新一次）"""
    with _board_chg_lock:
        if _board_chg_cache:
            return _board_chg_cache.copy()
    # 首次未缓存，快速返回空（后台加载）
    _kline_executor.submit(_reload_board_changes)
    return {}

def _reload_board_changes():
    """后台重新加载板块涨跌幅（增量式，仅读最后两行）"""
    import os as _os, csv as _csv, re as _re
    result = {}
    base = _os.path.join(_os.path.dirname(__file__), 'data')
    for dirname in ['行业板块K线数据', '概念板块K线数据']:
        dtype = 'industry' if '行业' in dirname else 'concept'
        d = _os.path.join(base, dirname)
        if not _os.path.exists(d):
            continue
        for fn in _os.listdir(d):
            if not fn.endswith('.csv'):
                continue
            m = _re.match(r'.+_(BK\d+)\.csv$', fn)
            if not m:
                continue
            code = m.group(1)
            try:
                with open(_os.path.join(d, fn), 'r', encoding='utf-8') as f:
                    # 只读最后两行，用seek跳到文件末尾
                    f.seek(0, 2)
                    size = f.tell()
                    if size < 50:
                        continue
                    # 读取最后400字节（足够覆盖两行）
                    f.seek(max(0, size - 400))
                    lines = f.read().strip().split('\n')
                    if len(lines) >= 3:
                        reader = csv.DictReader(lines[-3:])
                        rows = list(reader)
                        if len(rows) >= 2:
                            c0 = float(rows[-1]['收盘'])
                            c1 = float(rows[-2]['收盘'])
                            chg = round((c0 / c1 - 1) * 100, 2)
                            result[f'{dtype}:{code}'] = chg
            except:
                pass
    with _board_chg_lock:
        _board_chg_cache.clear()
        _board_chg_cache.update(result)

# 后台预加载板块涨跌幅（每60秒更新）
def _board_chg_refresher():
    evt = _tlk.Event()
    while True:
        _reload_board_changes()
        evt.wait(60)  # 每60秒刷新一次

_tlk.daemon = True
_bg_board_chg_thread = _tlk.daemon  # 标记
_tlk.Thread(target=_board_chg_refresher, daemon=True).start()

# 后台预加载顶部指数（启动时+今日未更新则拉取）
import threading as _t

def _prewarm_indices():
    from data_loader import load_index_kline, load_hk_index_kline, load_board_kline
    import time
    if is_today_updated():
        print("[预热] 今日已更新，跳过", flush=True)
        return
    print("[预热] 预加载顶部指数...", flush=True)
    for code, name, typ in [
        ('sh000001','上证指数','index'),('sz399006','创业板指','index'),
        ('sh000688','科创50','index'),('sh000300','沪深300','index'),
        ('sh000016','上证50','index'),('sh000852','中证1000','index'),
        ('sh000853','中证2000','index'),('sh000985','中证全指','index'),
        ('HSI','恒生指数','hk_index'),('HSTECH','恒生科技','hk_index'),
        ('BK1158','微盘股','concept'),('800000','东方财富全A','index'),
    ]:
        try:
            t0=time.time()
            {'hk_index':lambda:load_hk_index_kline(code),
             'concept':lambda:load_board_kline('concept',name,code)
            }.get(typ,lambda:load_index_kline(code))()
            print(f"[预热] {name} 完成 ({time.time()-t0:.1f}s)", flush=True)
        except Exception as e:
            print(f"[预热] {name} 失败: {e}", flush=True)

_t.Thread(target=_prewarm_indices, daemon=True).start()

# ====== QMT 行情服务启动 ======
import qmt_bridge
QMT_AVAILABLE = False

def _start_qmt():
    global QMT_AVAILABLE
    # 1. 启动miniquote(58610) - 长连接心跳保持在线
    print("[QMT] 初始化行情服务...", flush=True)
    if not qmt_bridge.ensure_runtime():
        print("[QMT] ✗ miniquote 启动失败", flush=True)
    else:
        print("[QMT] ✓ miniquote 就绪", flush=True)
    
    # 2. 验证RPC直连(58600)
    import subprocess as _sp, json as _js, os as _os
    qmt_py = r'D:\迅投极速策略交易系统交易终端 大同证券QMT实盘\bin.x64\python.exe'
    qmt_dir = r'D:\迅投极速策略交易系统交易终端 大同证券QMT实盘\bin.x64'
    try:
        proc = _sp.run([qmt_py, '-c', 'from xtquant import xtdata;r=xtdata.rpc_init("127.0.0.1:58600");print("RPC="+str(r))'],
                       capture_output=True, timeout=10, text=True, cwd=qmt_dir)
        if 'RPC=0' in proc.stdout:
            QMT_AVAILABLE = True
            print("[QMT] ✓ RPC直连就绪", flush=True)
            # 后台同步今日数据
            _t.Thread(target=_qmt_sync_all, daemon=True).start()
            return
    except: pass
    print("[QMT] ⚠️ 使用缓存数据", flush=True)

_t.Thread(target=_start_qmt, daemon=True).start()

# 启动miniquote心跳守护（每60秒轻量查询保持连接活性，防止进程退出）
def _miniquote_heartbeat():
    import time as _time
    while True:
        _time.sleep(60)
        try:
            from xtquant import xtdata as _xt
            _xt.connect(port=58610); _xt.enable_hello = False
            _xt.get_instrument_detail('000001.SH')
        except: pass
_t.Thread(target=_miniquote_heartbeat, daemon=True).start()


def _qmt_sync_all():
    """后台同步常用标的到SQLite"""
    import subprocess as _sp, json as _js, sqlite3 as _sql, os
    from pathlib import Path
    qmt_py = r'D:\迅投极速策略交易系统交易终端 大同证券QMT实盘\bin.x64\python.exe'
    qmt_dir = r'D:\迅投极速策略交易系统交易终端 大同证券QMT实盘\bin.x64'
    today = __import__('pandas').Timestamp.now().strftime('%Y%m%d')
    
    targets = [
        ('sh000001','000001.SH'),('sz399006','399006.SZ'),('sh000688','000688.SH'),
        ('sh000300','000300.SH'),('sh000016','000016.SH'),('sh000852','000852.SH'),
        ('sh000853','000853.SH'),('sh000985','000985.SH'),('HSI','HSI.HK'),
        ('HSTECH','HSTECH.HK'),('600519','600519.SH'),('600036','600036.SH'),
    ]
    
    for code, qmt_code in targets:
        try:
            script = (
                "from xtquant import xtdata; import pandas as pd, json\n"
                f"xtdata.rpc_init('127.0.0.1:58600')\n"
                f"xtdata.download_history_data('{qmt_code}','1d','{today}','{today}')\n"
                f"d=xtdata.get_local_data(['time','open','high','low','close','volume'],['{qmt_code}'],'1d','{today}','{today}',count=2)\n"
                f"if '{qmt_code}' in d and d['{qmt_code}'] is not None and not d['{qmt_code}'].empty:\n"
                " df=d['{qmt_code}'];r=[]\n"
                " for i,row in df.iterrows():\n"
                "  t=int(i)if isinstance(i,(int,float))and i>1e9 else 0\n"
                "  ds=pd.to_datetime(t,unit='ms').strftime('%Y-%m-%d')if t>1e9 else str(i)[:10]\n"
                "  r.append({'date':ds,'open':round(float(row['open']),2),'high':round(float(row['high']),2),'low':round(float(row['low']),2),'close':round(float(row['close']),2),'volume':int(float(row['volume']))})\n"
                " print(json.dumps({'ok':True,'data':r}))\n"
                "else:\n"
                " print(json.dumps({'ok':False}))"
            )
            proc = _sp.run([qmt_py, '-c', script], capture_output=True, timeout=15, text=True, cwd=qmt_dir)
            result = _js.loads(proc.stdout.strip()) if proc.stdout.strip() else {}
            if result.get('ok') and result.get('data'):
                conn = _sql.connect(str(Path('data')/'kline.db'))
                for row in result['data']:
                    conn.execute('INSERT OR REPLACE INTO kline (code,period,date,open,high,low,close,volume) VALUES (?,?,?,?,?,?,?,?)',
                        (code,'daily',row['date'],row['open'],row['high'],row['low'],row['close'],row['volume']))
                conn.commit(); conn.close()
        except: pass

