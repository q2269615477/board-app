# board-app 环境变量模板
# 复制此文件为 .env 并填入真实值

# Tushare 数据源 Token（必填，否则 Tushare 数据源不可用）
TUSHARE_TOKEN=your_token_here

# 应用启动控制（测试时设为 0，跳过 QMT/预热/后台线程）
BOARD_APP_AUTO_BOOTSTRAP=0

# QMT 相关
QMT_ENABLED=0
QMT_AUTO_START=0

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
DEBUG=False

# 标注 Vault 路径
ANNOTATION_VAULT_PATH=vault/TradingVault

# AI / LLM 分析（可选，用于 AI 炒股分析功能）
# OpenAI 兼容 API Key（如使用 OpenAI/DeepSeek/通义千问 等）
OPENAI_API_KEY=your_openai_api_key_here
# Anthropic Claude API Key（可选）
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Ollama 本地模型服务地址（可选，启用本地 LLM 时设置）
OLLAMA_BASE_URL=http://localhost:11434

# QMT 超时配置（单位：秒）
QMT_TIMEOUT_SPOT=15
QMT_TIMEOUT_CONSTITUENTS_LIVE=20
QMT_TIMEOUT_STOCK_LIST=30
QMT_TIMEOUT_DAILY_LOCAL=15
QMT_TIMEOUT_DAILY_FORMULA=60
QMT_TIMEOUT_DAILY_BATCH=120
QMT_TIMEOUT_MINUTE=30

# K 线同步超时与线程池配置
KLINE_SYNC_TIMEOUT=15
KLINE_BG_REFRESH_WORKERS=2

# 前端加载超时配置（单位：毫秒）
FRONTEND_KLINE_FETCH_TIMEOUT_MS=15000
FRONTEND_LOADING_MIN_MS=300
FRONTEND_LOADING_MAX_MS=8000
